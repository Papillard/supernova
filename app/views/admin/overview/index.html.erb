<div class="container mx-auto max-w-6xl px-4 py-12">
  <div class="space-y-8">
    <h1 class="text-4xl font-bold text-gray-900">Administration - Vue d'ensemble</h1>

    <!-- Summary Cards -->
    <div class="grid gap-4 md:grid-cols-4">
      <div class="card bg-white shadow-lg">
        <div class="card-body">
          <h2 class="card-title text-gray-600 text-sm">Total Professeurs</h2>
          <p class="text-3xl font-bold text-gray-900"><%= @total_teachers %></p>
        </div>
      </div>

      <div class="card bg-white shadow-lg">
        <div class="card-body">
          <h2 class="card-title text-gray-600 text-sm">Total Parents</h2>
          <p class="text-3xl font-bold text-gray-900"><%= @total_parents %></p>
        </div>
      </div>

      <div class="card bg-white shadow-lg">
        <div class="card-body">
          <h2 class="card-title text-gray-600 text-sm">Total Requetes</h2>
          <p class="text-3xl font-bold text-gray-900"><%= @total_requests %></p>
        </div>
      </div>

      <div class="card bg-white shadow-lg">
        <div class="card-body">
          <h2 class="card-title text-gray-600 text-sm">% Profs avec requetes</h2>
          <p class="text-3xl font-bold text-gray-900"><%= @teachers_with_requests_pct %>%</p>
        </div>
      </div>
    </div>

    <!-- Teachers cumulated -->
    <div class="card bg-white shadow-lg">
      <div class="card-body">
        <h2 class="card-title text-gray-900 mb-4">Professeurs inscrits (cumule)</h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Mois</th>
                <th>Total cumule</th>
              </tr>
            </thead>
            <tbody>
              <% @teachers_by_month.each do |month, count| %>
                <tr>
                  <td><%= I18n.l(month, format: "%B %Y") %></td>
                  <td><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Parents cumulated -->
    <div class="card bg-white shadow-lg">
      <div class="card-body">
        <h2 class="card-title text-gray-900 mb-4">Parents inscrits (cumule)</h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Mois</th>
                <th>Total cumule</th>
              </tr>
            </thead>
            <tbody>
              <% @parents_by_month.each do |month, count| %>
                <tr>
                  <td><%= I18n.l(month, format: "%B %Y") %></td>
                  <td><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Requests per month -->
    <div class="card bg-white shadow-lg">
      <div class="card-body">
        <h2 class="card-title text-gray-900 mb-4">Requetes par mois</h2>
        <div class="overflow-x-auto">
          <table class="table table-zebra">
            <thead>
              <tr>
                <th>Mois</th>
                <th>Nouvelles requetes</th>
              </tr>
            </thead>
            <tbody>
              <% @requests_by_month.each do |month, count| %>
                <tr>
                  <td><%= I18n.l(month, format: "%B %Y") %></td>
                  <td><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
