<div id="admin-message-<%= message.id %>">
  <% if message.system %>
    <div class="flex items-start gap-3">
      <div class="flex-shrink-0">
        <div class="rounded-full overflow-hidden flex-shrink-0 bg-gray-300 flex items-center justify-center w-10 h-10">
          <div class="flex items-center justify-center text-gray-600 font-semibold text-xs w-10 h-10">PC</div>
        </div>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-sm font-semibold text-gray-900">ProfConnect (système)</span>
          <span class="text-xs text-gray-500"><%= message.created_at.strftime("%d/%m/%Y à %H:%M") %></span>
        </div>
        <div class="bg-gray-100 rounded-2xl rounded-tl-sm px-4 py-3 inline-block max-w-[80%]">
          <p class="text-gray-900 whitespace-pre-line text-sm leading-relaxed"><%= message.body %></p>
        </div>
      </div>
    </div>
  <% elsif message.user.teacher? %>
    <% teacher = message.user.teacher %>
    <div class="flex items-start gap-3">
      <div class="flex-shrink-0">
        <%= render "shared/teacher_avatar", teacher: teacher, size: :small, for_parent: false %>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-sm font-semibold text-gray-900">
            <%= "#{teacher.first_name} #{teacher.last_name}".strip.presence || teacher_short_name(teacher) %>
          </span>
          <span class="badge badge-sm">prof</span>
          <span class="text-xs text-gray-500"><%= message.created_at.strftime("%d/%m/%Y à %H:%M") %></span>
        </div>
        <div class="bg-gray-100 rounded-2xl rounded-tl-sm px-4 py-3 inline-block max-w-[80%]">
          <p class="text-gray-900 whitespace-pre-line text-sm leading-relaxed"><%= message.body %></p>
        </div>
      </div>
    </div>
  <% else %>
    <% parent_profile = message.user.parent_profile %>
    <% parent_name = if parent_profile && (parent_profile.first_name.present? || parent_profile.last_name.present?)
         "#{parent_profile.first_name} #{parent_profile.last_name}".strip
       else
         message.user.email
       end %>
    <div class="flex items-start gap-3 justify-end">
      <div class="flex-1 min-w-0 flex flex-col items-end">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs text-gray-500"><%= message.created_at.strftime("%d/%m/%Y à %H:%M") %></span>
          <span class="badge badge-sm">parent</span>
          <span class="text-sm font-semibold text-gray-900"><%= parent_name %></span>
        </div>
        <div class="rounded-2xl rounded-tr-sm px-4 py-3 inline-block max-w-[80%]" style="background-color: #3F3F3F;">
          <p class="text-white whitespace-pre-line text-sm leading-relaxed"><%= message.body %></p>
        </div>
      </div>
      <div class="flex-shrink-0">
        <% if parent_profile %>
          <%= render "shared/parent_avatar", parent_profile: parent_profile, size: :small %>
        <% else %>
          <div class="rounded-full overflow-hidden flex-shrink-0 bg-gray-300 flex items-center justify-center w-10 h-10">
            <div class="flex items-center justify-center text-gray-600 font-semibold text-xs w-10 h-10">
              <%= message.user.email[0].upcase %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
