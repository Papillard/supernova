<div class="container mx-auto max-w-4xl px-4 py-8">
  <div class="space-y-6">
    <h1 class="text-3xl font-bold text-gray-900">Mon profil professeur</h1>

    <!-- Flash messages container -->
    <div id="flash-messages"></div>
    <% if flash[:notice] %>
      <div class="alert alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="alert alert-error">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <!-- Bannière statut -->
    <% if @teacher.pending? %>
      <div class="alert alert-warning">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Votre profil est en cours de validation.</span>
      </div>
    <% elsif @teacher.approved? %>
      <div class="alert alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Votre profil est validé et visible des parents.</span>
      </div>
    <% elsif @teacher.rejected? %>
      <div class="alert alert-error">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Votre profil a été refusé.</span>
      </div>
    <% end %>

    <!-- Section Photo de profil (formulaire séparé) -->
    <div class="card bg-white shadow-sm mb-6">
      <div class="card-body">
        <h2 class="card-title text-xl mb-4">Photo de profil</h2>
        <div class="flex items-start gap-6" data-controller="avatar-upload">
            <div class="flex-shrink-0" id="teacher-avatar-container">
              <%= render "shared/teacher_avatar", teacher: @teacher, size: :large, for_parent: false %>
              <div id="avatar-upload-loading" class="hidden mt-2 text-sm text-gray-500 text-center" data-avatar-upload-target="loadingIndicator">
                Upload en cours...
              </div>
            </div>
          <div class="flex-1 space-y-4">
            <!-- Formulaire séparé pour l'upload d'avatar -->
            <%= form_with model: @teacher, url: teacher_profile_path, method: :patch, local: false, multipart: true, data: { turbo: true, avatar_upload_target: "form" }, id: "avatar-upload-form", class: "space-y-4" do |avatar_form| %>
              <div class="form-control">
                <%= avatar_form.label :avatar, "Changer la photo", class: "label" do %>
                  <span class="label-text">Photo de profil</span>
                <% end %>
                <%= avatar_form.file_field :avatar,
                    accept: "image/jpeg,image/jpg,image/png",
                    class: "file-input file-input-bordered w-full",
                    data: { avatar_upload_target: "input" } %>
                <label class="label">
                  <span class="label-text-alt text-gray-500">Formats acceptés : JPEG, PNG</span>
                </label>
              </div>
              <div class="form-control">
                <label class="label cursor-pointer justify-start gap-2">
                  <%= avatar_form.check_box :picture_visible, { checked: @teacher.picture_visible }, true, false %>
                  <span class="label-text">Afficher ma photo aux parents (annuaire et profil public)</span>
                </label>
                <label class="label">
                  <span class="label-text-alt text-gray-500">Si cette option est désactivée, seules vos initiales seront visibles pour les parents</span>
                </label>
              </div>
              <!-- Champ caché pour indiquer que c'est un upload d'avatar -->
              <%= hidden_field_tag "avatar_only", "1" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= form_with model: @teacher, url: teacher_profile_path, method: :patch, local: false, multipart: true, data: { turbo: true }, class: "space-y-6" do |f| %>
      <%= render "devise/shared/error_messages", resource: @teacher %>

      <!-- Section Identité -->
      <div class="card bg-white shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Identité</h2>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="form-control">
              <%= f.label :first_name, class: "label" do %>
                <span class="label-text">Prénom *</span>
              <% end %>
              <%= f.text_field :first_name, class: "input input-bordered w-full", required: true %>
            </div>
            <div class="form-control">
              <%= f.label :last_name, class: "label" do %>
                <span class="label-text">Nom *</span>
              <% end %>
              <%= f.text_field :last_name, class: "input input-bordered w-full", required: true %>
            </div>
            <div class="form-control">
              <%= f.label :gender, class: "label" do %>
                <span class="label-text">Genre *</span>
              <% end %>
              <%= f.select :gender, options_for_select([["Féminin", "female"], ["Masculin", "male"]], @teacher.gender), { prompt: "Sélectionner" }, { class: "select select-bordered w-full", required: true } %>
            </div>
            <div class="form-control">
              <%= f.label :academy_name, class: "label" do %>
                <span class="label-text">Académie</span>
              <% end %>
              <%= f.text_field :academy_name, class: "input input-bordered w-full", placeholder: "Paris" %>
            </div>
            <div class="form-control">
              <%= f.label :school_name, class: "label" do %>
                <span class="label-text">Établissement</span>
              <% end %>
              <%= f.text_field :school_name, class: "input input-bordered w-full", placeholder: "Lycée Montaigne" %>
            </div>
            <div class="form-control">
              <%= f.label :career_status, class: "label" do %>
                <span class="label-text">Statut professionnel *</span>
              <% end %>
              <%= f.select :career_status, options_for_select([
                ["Certifié", "certifié"],
                ["Agrégé", "agrégé"],
                ["Prof des écoles", "prof des écoles"],
                ["Autre", "autre"]
              ], @teacher.career_status), { prompt: "Sélectionner" }, { class: "select select-bordered w-full", required: true } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Matières / Niveaux / Formats -->
      <div class="card bg-white shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Matières, Niveaux & Formats</h2>
          <div class="space-y-4">
            <div class="form-control">
              <%= f.label :levels, class: "label" do %>
                <span class="label-text">Niveaux</span>
              <% end %>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-2 p-4 border border-stone-300 rounded-lg bg-base-100">
                <% TeachersHelper::LEVELS_OPTIONS.reject { |_, value| value == "autre" }.each do |label, value| %>
                  <label class="flex items-center gap-2 cursor-pointer p-2 rounded hover:bg-base-200 transition">
                    <%= check_box_tag "teacher[levels][]", value, @teacher.levels&.include?(value), { id: "teacher_levels_#{value.parameterize}", class: "checkbox checkbox-primary checkbox-sm level-checkbox", data: { level: value } } %>
                    <span class="text-sm"><%= label %></span>
                  </label>
                <% end %>
              </div>
              <%= hidden_field_tag "teacher[levels][]", "" %>
            </div>
            <div class="form-control">
              <%= f.label :subjects_tags, class: "label" do %>
                <span class="label-text">Matières</span>
              <% end %>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-2 p-4 border border-stone-300 rounded-lg bg-base-100 max-h-96 overflow-y-auto" id="subjects-container">
                <% TeachersHelper::SUBJECTS_OPTIONS.each do |label, value| %>
                  <label class="flex items-center gap-2 cursor-pointer p-2 rounded hover:bg-base-200 transition">
                    <%= check_box_tag "teacher[subjects_tags][]", value, @teacher.subjects_tags&.include?(value), { id: "teacher_subjects_tags_#{value.parameterize}", class: "checkbox checkbox-primary checkbox-sm" } %>
                    <span class="text-sm"><%= label %></span>
                  </label>
                <% end %>
              </div>
              <%= hidden_field_tag "teacher[subjects_tags][]", "" %>
            </div>
            <div class="form-control">
              <label class="label">
                <span class="label-text">Formats d'enseignement</span>
              </label>
              <div class="flex flex-wrap gap-4">
                <label class="label cursor-pointer gap-2">
                  <%= check_box_tag "teacher[teaching_formats][]", "online", @teacher.teaching_formats&.include?("online"), { id: "teacher_teaching_formats_online" } %>
                  <span class="label-text">En ligne</span>
                </label>
                <label class="label cursor-pointer gap-2">
                  <%= check_box_tag "teacher[teaching_formats][]", "at_student_home", @teacher.teaching_formats&.include?("at_student_home"), { id: "teacher_teaching_formats_at_student_home" } %>
                  <span class="label-text">Au domicile de l'élève</span>
                </label>
                <label class="label cursor-pointer gap-2">
                  <%= check_box_tag "teacher[teaching_formats][]", "at_teacher_home", @teacher.teaching_formats&.include?("at_teacher_home"), { id: "teacher_teaching_formats_at_teacher_home" } %>
                  <span class="label-text">À mon domicile</span>
                </label>
              </div>
            </div>
            <div class="form-control">
              <%= f.label :pricing_text, class: "label" do %>
                <span class="label-text">Tarif horaire</span>
              <% end %>
              <%= f.select :pricing_text, options_for_select((40..100).step(5).map { |price| ["#{price}€", "#{price}€"] }, @teacher.pricing_text), { prompt: "Sélectionner un tarif" }, { class: "select select-bordered w-full" } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Localisation -->
      <div class="card bg-white shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Localisation</h2>
          <div class="grid gap-4 md:grid-cols-3">
            <div class="form-control">
              <%= f.label :base_city, class: "label" do %>
                <span class="label-text">Ville</span>
              <% end %>
              <%= f.text_field :base_city, class: "input input-bordered w-full", placeholder: "Paris" %>
            </div>
            <div class="form-control">
              <%= f.label :base_zip_code, class: "label" do %>
                <span class="label-text">Code postal</span>
              <% end %>
              <%= f.text_field :base_zip_code, class: "input input-bordered w-full", placeholder: "75014" %>
            </div>
            <div class="form-control">
              <%= f.label :radius_text, class: "label" do %>
                <span class="label-text">Rayon d'intervention</span>
              <% end %>
              <%= f.text_field :radius_text, class: "input input-bordered w-full", placeholder: "Ex: 20 km" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Description -->
      <div class="card bg-white shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Description</h2>
          <div class="space-y-4">
            <div class="form-control">
              <%= f.label :support_text, class: "label" do %>
                <span class="label-text">Texte de soutien</span>
              <% end %>
              <%= f.text_area :support_text, class: "textarea textarea-bordered w-full", rows: 4, placeholder: "Décrivez votre approche pédagogique..." %>
            </div>
            <div class="form-control">
              <%= f.label :experience_text, class: "label" do %>
                <span class="label-text">Expérience</span>
              <% end %>
              <%= f.text_area :experience_text, class: "textarea textarea-bordered w-full", rows: 4, placeholder: "Décrivez votre expérience..." %>
            </div>
            <div class="form-control">
              <%= f.label :special_skills_text, class: "label" do %>
                <span class="label-text">Compétences spéciales</span>
              <% end %>
              <%= f.text_area :special_skills_text, class: "textarea textarea-bordered w-full", rows: 4, placeholder: "Vos compétences particulières..." %>
            </div>
            <div class="form-control">
              <%= f.label :interest_text, class: "label" do %>
                <span class="label-text">Centres d'intérêt</span>
              <% end %>
              <%= f.text_area :interest_text, class: "textarea textarea-bordered w-full", rows: 4, placeholder: "Vos centres d'intérêt..." %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Examens & Pédagogie -->
      <div class="card bg-white shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Examens & Pédagogie</h2>
          <div class="space-y-4">
            <div class="form-control">
              <%= f.label :exams_raw_text, class: "label" do %>
                <span class="label-text">Examens préparés</span>
              <% end %>
              <%= f.text_area :exams_raw_text, class: "textarea textarea-bordered w-full", rows: 3, placeholder: "Décrivez les examens que vous préparez..." %>
            </div>
            <div class="form-control">
              <%= f.label :exam_tags, class: "label" do %>
                <span class="label-text">Tags examens</span>
              <% end %>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-2 p-4 border border-stone-300 rounded-lg bg-base-100 max-h-64 overflow-y-auto">
                <% TeachersHelper::EXAM_TAGS_OPTIONS.each do |label, value| %>
                  <label class="flex items-center gap-2 cursor-pointer p-2 rounded hover:bg-base-200 transition">
                    <%= check_box_tag "teacher[exam_tags][]", value, @teacher.exam_tags&.include?(value), { id: "teacher_exam_tags_#{value.parameterize}", class: "checkbox checkbox-primary checkbox-sm" } %>
                    <span class="text-sm"><%= label %></span>
                  </label>
                <% end %>
              </div>
              <%= hidden_field_tag "teacher[exam_tags][]", "" %>
            </div>
            <div class="form-control">
              <%= f.label :pedagogy_tags, class: "label" do %>
                <span class="label-text">Tags pédagogie</span>
              <% end %>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-2 p-4 border border-stone-300 rounded-lg bg-base-100 max-h-64 overflow-y-auto">
                <% TeachersHelper::PEDAGOGY_TAGS_OPTIONS.each do |label, value| %>
                  <label class="flex items-center gap-2 cursor-pointer p-2 rounded hover:bg-base-200 transition">
                    <%= check_box_tag "teacher[pedagogy_tags][]", value, @teacher.pedagogy_tags&.include?(value), { id: "teacher_pedagogy_tags_#{value.parameterize}", class: "checkbox checkbox-primary checkbox-sm" } %>
                    <span class="text-sm"><%= label %></span>
                  </label>
                <% end %>
              </div>
              <%= hidden_field_tag "teacher[pedagogy_tags][]", "" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Données sensibles -->
      <div class="card bg-white shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Données de contact (privées)</h2>
          <div class="space-y-4">
            <div class="form-control">
              <%= f.label :email_pro, class: "label" do %>
                <span class="label-text">Email professionnel *</span>
              <% end %>
              <%= f.email_field :email_pro, class: "input input-bordered w-full", required: true %>
            </div>
            <div class="form-control">
              <%= f.label :email_perso, class: "label" do %>
                <span class="label-text">Email personnel</span>
              <% end %>
              <%= f.email_field :email_perso, class: "input input-bordered w-full" %>
            </div>
            <div class="form-control">
              <%= f.label :phone, class: "label" do %>
                <span class="label-text">Téléphone</span>
              <% end %>
              <%= f.text_field :phone, class: "input input-bordered w-full", placeholder: "06 00 00 00 00" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Section RGPD -->
      <div class="card bg-white shadow-sm border-2">
        <div class="card-body">
          <h2 class="card-title text-xl mb-4">Consentement RGPD</h2>
          <div class="form-control">
            <label class="label cursor-pointer justify-start gap-2">
              <%= f.check_box :rgpd_consent, { checked: @teacher.rgpd_consent }, true, false %>
              <span class="label-text">J'accepte que mes données soient utilisées conformément à la RGPD *</span>
            </label>
            <label class="label">
              <span class="label-text-alt text-red-600">Ce consentement est obligatoire pour que votre profil soit visible</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Bouton submit -->
      <div class="flex justify-end">
        <%= f.submit "Enregistrer mon profil", class: "btn btn-primary bg-blue-600 hover:bg-blue-700 border-blue-600 text-white rounded-lg" %>
      </div>
    <% end %>
  </div>
</div>
