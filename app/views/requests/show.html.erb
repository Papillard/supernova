<% content_for :main_background, "background-color: #ffffff;" %>
<% content_for :hide_mobile_nav do %><% end %>

<% messages = @request.messages.order(created_at: :asc) %>

<div class="flex flex-col h-[calc(100vh-4rem)]">
  <!-- Header avec bouton retour -->
  <div class="border-b border-gray-200 px-4 py-3 flex-shrink-0 bg-white">
    <div class="flex items-center gap-3">
      <%= link_to requests_path, class: "btn btn-ghost btn-sm btn-square" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <div class="flex-1 min-w-0">
        <h2 class="font-bold text-gray-900 truncate">
          <% if @request.status == "accepted" %>
            <%= "#{@request.teacher.first_name} #{@request.teacher.last_name}" %>
          <% else %>
            <%= teacher_short_name(@request.teacher) %>
          <% end %>
        </h2>
        <p class="text-xs text-gray-500 truncate">
          <%= format_subject_tag(@request.subject) %> • <%= format_request_level(@request.level) %> • <%= format_request_status(@request.status) %>
        </p>
      </div>
      <%= button_to archive_request_path(@request), method: :patch,
          class: "btn btn-ghost btn-sm btn-square text-gray-400",
          data: { "turbo-confirm": "Êtes-vous sûr de vouloir archiver cette demande ?" },
          title: "Archiver" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
        </svg>
      <% end %>
    </div>
  </div>

  <!-- Zone de messages (scrollable) -->
  <div id="messages-container-<%= @request.id %>" class="flex-1 overflow-y-auto px-4 py-4 space-y-4 bg-gray-50" style="padding-bottom: 5rem;">
    <% messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>
  </div>
</div>

<!-- Formulaire de message (fixed au-dessus de la bottom nav) -->
<% if @request.status == "accepted" || @request.status == "pending" %>
  <div class="md:hidden fixed left-0 right-0 z-40 border-t border-gray-200 px-4 py-3 bg-white" style="bottom: calc(4.8rem + env(safe-area-inset-bottom, 0px));">
    <%= form_with model: [@request, Message.new], url: request_messages_path(@request), local: false, id: "message-form-#{@request.id}", class: "flex gap-2 items-end" do |f| %>
      <%= f.text_area :body, id: "message-body-#{@request.id}", class: "flex-1 resize-none border border-gray-300 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#fe6618] focus:border-transparent text-base", placeholder: "Message...", rows: 1, required: true, style: "min-height: 40px; max-height: 120px;" %>
      <button type="submit" class="btn btn-circle bg-[#fe6618] hover:bg-[#e55a15] text-white border-none h-10 w-10 min-h-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    <% end %>
  </div>
<% end %>

<!-- Mobile Bottom Navigation (toujours visible) -->
<%= render "shared/mobile_bottom_nav" %>

<script>
  (function() {
    function initMobileChat() {
      const requestId = <%= @request.id %>;
      const textarea = document.getElementById('message-body-' + requestId);
      const form = document.getElementById('message-form-' + requestId);
      const messagesContainer = document.getElementById('messages-container-' + requestId);

      // Auto-scroll initial
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }

      // Auto-resize textarea
      if (textarea) {
        textarea.addEventListener('input', function() {
          this.style.height = 'auto';
          this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });

        // Envoi au clavier (Enter sans Shift)
        textarea.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (textarea.value.trim() && form) {
              form.requestSubmit();
            }
          }
        });
      }
    }

    // Initialisation
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileChat);
    } else {
      initMobileChat();
    }

    document.addEventListener('turbo:load', initMobileChat);
    document.addEventListener('turbo:frame-load', initMobileChat);

    // Auto-scroll après ajout de message
    const observer = new MutationObserver(function(mutations) {
      const requestId = <%= @request.id %>;
      const messagesContainer = document.getElementById('messages-container-' + requestId);
      const textarea = document.getElementById('message-body-' + requestId);

      mutations.forEach(function(mutation) {
        if (mutation.addedNodes.length > 0 && messagesContainer) {
          setTimeout(function() {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            if (textarea) {
              textarea.value = '';
              textarea.style.height = 'auto';
            }
          }, 10);
        }
      });
    });

    const container = document.getElementById('messages-container-<%= @request.id %>');
    if (container) {
      observer.observe(container, { childList: true });
    }
  })();
</script>
