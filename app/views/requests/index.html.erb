<% content_for :main_background, "background-color: oklch(0.985 0.002 247.839);" %>

<div class="max-w-7xl mx-auto h-[calc(100vh-4rem)] flex gap-6 px-4 md:px-6 py-4">
  <!-- Colonne gauche (1/3) - Liste des demandes -->
  <div class="flex-shrink-0 w-1/3 border-r border-gray-200 pr-6 flex flex-col">
    <div class="mb-6 flex-shrink-0">
      <h1 class="text-2xl font-bold text-gray-900">Mes demandes</h1>
      <p class="text-sm text-gray-600 mt-1">Retrouvez toutes vos demandes</p>
    </div>

    <% if @requests.any? %>
      <div class="flex-1 overflow-y-auto space-y-2">
        <% @requests.each do |request| %>
          <%= link_to requests_path(id: request.id), class: "block" do %>
            <div class="p-4 rounded-lg border transition-colors <%= @active_request&.id == request.id ? 'bg-[#fe6618]/5 border-[#fe6618]/30' : 'bg-white border-gray-200 hover:bg-white' %>">
              <div class="flex items-start justify-between mb-2">
                <h3 class="font-semibold text-gray-900 text-sm">
                  <% if request.status == "accepted" %>
                    <%= "#{request.teacher.first_name} #{request.teacher.last_name}" %>
                  <% else %>
                    <%= teacher_short_name(request.teacher) %>
                  <% end %>
                </h3>
                <span class="badge <%= request_status_badge_class(request.status) %> badge-sm">
                  <%= format_request_status(request.status) %>
                </span>
              </div>
              <p class="text-sm text-gray-500 mb-2">
                Demande pour cours de <%= format_subject_tag(request.subject).downcase %>
              </p>
              <div class="flex flex-wrap gap-1">
                <% if request.student&.first_name.present? %>
                  <span class="badge badge-sm bg-green-100 text-green-700 border-green-200">
                    <%= request.student.first_name %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card bg-white shadow-md flex-shrink-0">
        <div class="card-body text-center py-12">
          <p class="text-gray-600 text-lg">Vous n'avez pas encore de demandes.</p>
          <p class="text-gray-500 mt-2 text-sm">Parcourez l'annuaire des professeurs pour en créer une.</p>
          <%= link_to "Voir les professeurs", teachers_path, class: "btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white mt-4 btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Colonne droite (2/3) - Chat -->
  <div class="flex-1 min-w-0 flex flex-col">
    <% if @active_request %>
      <%= render "conversation", request: @active_request %>
    <% else %>
      <div class="card bg-white shadow-lg h-full flex items-center justify-center">
        <div class="text-center">
          <p class="text-gray-600 text-lg mb-2">Sélectionnez une demande</p>
          <p class="text-gray-500 text-sm">Choisissez une conversation dans la liste pour commencer</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
