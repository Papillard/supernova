<div class="min-h-screen bg-white flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md md:max-w-xl w-full space-y-8">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-gray-900">ProfConnect</h1>
      <h2 class="mt-2 text-xl text-gray-600">Créer un compte professeur</h2>
      <p class="mt-1 text-sm text-gray-500">Rejoignez la communauté des enseignants de l'Éducation Nationale</p>
    </div>

    <div class="card bg-white shadow-lg">
      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: teacher_registration_path, html: { class: "space-y-6" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="grid grid-cols-2 gap-4">
            <div class="form-control">
              <%= f.label :first_name, class: "label" do %>
                <span class="label-text">Prénom *</span>
              <% end %>
              <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", class: "input input-bordered w-full", placeholder: "Prénom", required: true %>
            </div>

            <div class="form-control">
              <%= f.label :last_name, class: "label" do %>
                <span class="label-text">Nom *</span>
              <% end %>
              <%= f.text_field :last_name, autocomplete: "family-name", class: "input input-bordered w-full", placeholder: "Nom", required: true %>
            </div>
          </div>

          <div class="form-control">
            <%= f.label :email, class: "label" do %>
              <span class="label-text">Email professionnel *</span>
            <% end %>
            <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full", placeholder: "votre.email@ac-*.fr", required: true %>
            <label class="label">
              <span class="label-text-alt text-gray-500">Utilisez votre email académique si possible</span>
            </label>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-control">
              <%= f.label :password, class: "label" do %>
                <span class="label-text">Mot de passe</span>
                <% if @minimum_password_length %>
                  <span class="label-text-alt">(<%= @minimum_password_length %> caractères minimum)</span>
                <% end %>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full", placeholder: "••••••••" %>
            </div>

            <div class="form-control">
              <%= f.label :password_confirmation, class: "label" do %>
                <span class="label-text">Confirmer le mot de passe</span>
              <% end %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full", placeholder: "••••••••" %>
            </div>
          </div>

          <!-- Checkboxes légales -->
          <div class="space-y-3 pt-4 border-t border-gray-200">
            <div class="form-control">
              <label class="flex items-start gap-3 cursor-pointer">
                <%= check_box_tag "user[accept_cgs]", "1", false, { class: "checkbox checkbox-primary flex-shrink-0 mt-0.5", required: true } %>
                <span class="text-sm text-gray-700 leading-relaxed">
                  J'ai lu et j'accepte les
                  <%= link_to "Conditions Générales de Services (CGS)", conditions_generales_path, target: "_blank", class: "text-[#fe6618] hover:underline" %>
                  de ProfConnect. *
                </span>
              </label>
            </div>
            <div class="form-control">
              <label class="flex items-start gap-3 cursor-pointer">
                <%= check_box_tag "user[accept_privacy_policy]", "1", false, { class: "checkbox checkbox-primary flex-shrink-0 mt-0.5", required: true } %>
                <span class="text-sm text-gray-700 leading-relaxed">
                  J'accepte la
                  <%= link_to "Politique de confidentialité", politique_de_confidentialite_path, target: "_blank", class: "text-[#fe6618] hover:underline" %>
                  et consens au traitement de mes données pour la certification de mon profil et la mise en relation. Je comprends que mes justificatifs de diplômes sont supprimés après vérification. *
                </span>
              </label>
            </div>
          </div>

          <div class="form-control mt-6">
            <%= f.submit "Créer mon compte professeur", class: "btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white rounded-lg w-full" %>
          </div>
        <% end %>

        <div class="divider">OU</div>

        <div class="text-center space-y-2">
          <p class="text-sm text-gray-600">
            Déjà un compte ?
            <%= link_to "Se connecter", new_session_path(resource_name), class: "link link-primary" %>
          </p>
          <p class="text-sm text-gray-600">
            Vous êtes parent ?
            <%= link_to "Créer un compte parent", new_parent_registration_path, class: "link link-primary" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
