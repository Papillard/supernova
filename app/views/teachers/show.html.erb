<% content_for :main_background, "background-color: var(--color-stone-50);" %>

<div class="container mx-auto max-w-4xl px-4 py-12">
  <div class="space-y-6">
    <%= link_to "← Retour à l'annuaire", teachers_path, class: "link link-primary" %>

    <div class="card bg-white shadow-lg">
      <div class="card-body">
        <div class="flex items-start gap-6 mb-6">
          <%= render "shared/teacher_avatar", teacher: @teacher, size: :large, for_parent: true %>
          <div class="flex-1">
            <h1 class="text-3xl font-bold text-gray-900"><%= teacher_short_name(@teacher) %></h1>
            <% if @teacher.academy_name.present? %>
              <p class="text-lg text-gray-600 mt-1"><%= @teacher.academy_name %></p>
            <% end %>
            <% if @teacher.school_name.present? %>
              <p class="text-sm text-gray-500 mt-1"><%= @teacher.school_name %></p>
            <% end %>
            <% if @teacher.career_status.present? %>
              <p class="text-sm text-gray-500 mt-1"><%= @teacher.career_status.humanize %></p>
            <% end %>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-6">
          <% if @teacher.levels.present? %>
            <% @teacher.levels.each do |level| %>
              <span class="badge badge-sm bg-orange-100 text-orange-700 border-orange-200"><%= format_level_tag(level) %></span>
            <% end %>
          <% end %>
          <% if @teacher.subjects_tags.present? %>
            <% @teacher.subjects_tags.each do |tag| %>
              <span class="badge badge-sm bg-blue-100 text-blue-700 border-blue-200"><%= format_subject_tag(tag) %></span>
            <% end %>
          <% end %>
        </div>

        <div class="divider"></div>

        <% if @teacher.teaching_formats.present? %>
          <div class="mb-4">
            <h3 class="font-semibold text-gray-900 mb-2">Formats d'enseignement</h3>
            <p class="text-gray-600"><%= @teacher.teaching_formats.map { |f| f.humanize }.join(", ") %></p>
          </div>
        <% end %>

        <% if @teacher.base_city.present? %>
          <div class="mb-4">
            <h3 class="font-semibold text-gray-900 mb-2">Localisation</h3>
            <p class="text-gray-600">
              📍 <%= @teacher.base_city %>
              <% if @teacher.base_zip_code.present? %>
                (<%= @teacher.base_zip_code %>)
              <% end %>
              <% if @teacher.radius_text.present? %>
                - Rayon: <%= @teacher.radius_text %>
              <% end %>
            </p>
          </div>
        <% end %>

        <% if @teacher.support_text.present? %>
          <div class="mb-4">
            <h3 class="font-semibold text-gray-900 mb-2">Approche pédagogique</h3>
            <p class="text-gray-600 whitespace-pre-line"><%= @teacher.support_text %></p>
          </div>
        <% end %>

        <% if @teacher.experience_text.present? %>
          <div class="mb-4">
            <h3 class="font-semibold text-gray-900 mb-2">Expérience</h3>
            <p class="text-gray-600 whitespace-pre-line"><%= @teacher.experience_text %></p>
          </div>
        <% end %>

        <% if @teacher.pricing_text.present? %>
          <div class="mb-4">
            <h3 class="font-semibold text-gray-900 mb-2">Tarifs</h3>
            <p class="text-gray-600 whitespace-pre-line"><%= @teacher.pricing_text %></p>
          </div>
        <% end %>

        <div class="divider"></div>

        <div class="text-center mt-6">
          <p class="text-gray-600 mb-4">Intéressé(e) par ce professeur ?</p>
          <% if user_signed_in? && current_user.parent? %>
            <button onclick="request_modal.showModal()" class="btn btn-primary bg-blue-600 hover:bg-blue-700 border-blue-600 text-white rounded-lg">
              Demander une mise en relation
            </button>
          <% else %>
            <%= link_to "Se connecter pour demander une mise en relation", new_user_session_path, class: "btn btn-primary bg-blue-600 hover:bg-blue-700 border-blue-600 text-white rounded-lg" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if user_signed_in? && current_user.parent? %>
  <!-- Modal pour créer une demande -->
  <dialog id="request_modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Demander une mise en relation</h3>
      <%= form_with url: requests_path, local: true, class: "space-y-4" do |f| %>
        <%= hidden_field_tag :teacher_id, @teacher.id %>

        <div class="form-control">
          <%= f.label :subject, class: "label" do %>
            <span class="label-text">Matière principale</span>
          <% end %>
          <%= select_tag "request[subject]", options_for_select(TeachersHelper::SUBJECTS_OPTIONS), { prompt: "Sélectionnez une matière", class: "select select-bordered w-full", required: true } %>
        </div>

        <div class="form-control">
          <%= label_tag "request[level]", "Niveau", class: "label" do %>
            <span class="label-text">Niveau</span>
          <% end %>
          <%= select_tag "request[level]", options_for_select(RequestsHelper::LEVELS_OPTIONS), { prompt: "Sélectionnez un niveau", class: "select select-bordered w-full", required: true } %>
        </div>

        <div class="form-control">
          <%= label_tag "request[request_text]", "Description de votre besoin", class: "label" do %>
            <span class="label-text">Description de votre besoin</span>
          <% end %>
          <%= text_area_tag "request[request_text]", nil, class: "textarea textarea-bordered w-full h-24", placeholder: "Décrivez brièvement votre besoin...", required: true %>
        </div>

        <div class="modal-action">
          <button type="button" onclick="request_modal.close()" class="btn btn-ghost">Annuler</button>
          <%= f.submit "Envoyer la demande", class: "btn btn-primary bg-blue-600 hover:bg-blue-700 border-blue-600 text-white" %>
        </div>
      <% end %>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
<% end %>
