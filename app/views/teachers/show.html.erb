<% content_for :main_background, "background-color: oklch(0.985 0.002 247.839);" %>
<%
  subjects = @teacher.subjects_tags.present? ? @teacher.subjects_tags.map { |t| format_subject_tag(t) }.join(", ") : "plusieurs matières"
  location = @teacher.city.present? ? "à #{@teacher.city}" : "en France"
%>
<% content_for(:title) { "Professeur de l'Éducation nationale en #{subjects} #{location} | ProfConnect" } %>
<% content_for(:description) { "Professeur certifié en #{subjects} #{location}, proposant des cours particuliers adaptés au niveau et aux objectifs de chaque élève." } %>

<div class="container mx-auto max-w-7xl px-4 py-8">
  <!-- Bandeau d'inscription pour les utilisateurs non connectés -->
  <% unless user_signed_in? %>
    <div class="mb-6 bg-gradient-to-r from-[#fe6618] to-[#d85514] text-white rounded-lg p-6 shadow-lg">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex-1 text-center md:text-left">
          <h3 class="text-xl font-bold mb-2">S'inscrire gratuitement sur ProfConnect</h3>
          <p class="text-white/90">Pour voir la fiche détaillée des professeurs et demander une mise en relation</p>
        </div>
        <div class="flex gap-3">
          <%= link_to "S'inscrire", new_parent_registration_path, class: "btn bg-white text-[#fe6618] hover:bg-gray-100 border-white rounded-lg font-semibold" %>
          <%= link_to "Se connecter", new_user_session_path, class: "btn bg-transparent border-2 border-white text-white hover:bg-white/10 rounded-lg" %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Barre supérieure avec retour -->
  <div class="mb-6">
    <%= link_to "← Retour à l'annuaire", teachers_path, class: "text-gray-500 hover:text-gray-700 no-underline text-sm" %>
  </div>

  <% if user_signed_in? %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Colonne gauche (1/3) - Profil sticky -->
      <div class="lg:col-span-1">
        <div class="card bg-white shadow-sm sticky top-4">
          <div class="card-body">
            <!-- Avatar + Nom -->
            <div class="flex flex-col items-center mb-4">
              <div class="mb-4">
                <%= render "shared/teacher_avatar", teacher: @teacher, size: :large, for_parent: true %>
              </div>
              <h1 class="text-2xl font-bold text-gray-900 text-center mb-2">
                <%= teacher_short_name(@teacher) %>
              </h1>
              <!-- Ligne méta courte -->
              <div class="flex flex-wrap items-center justify-center gap-2 text-sm text-gray-600">
                <% meta_parts = [] %>
                <% meta_parts << @teacher.city if @teacher.city.present? %>
                <% meta_parts << format_career_status(@teacher.read_attribute(:career_status)) if @teacher.career_status.present? %>
                <% meta_parts << @teacher.school_name if @teacher.school_name.present? %>
                <% if meta_parts.any? %>
                  <span><%= meta_parts.join(" • ") %></span>
                <% end %>
              </div>
            </div>

            <!-- Bloc fit -->
            <div class="space-y-3 mb-6">
              <!-- Chips Matières -->
              <% if @teacher.subjects_tags.present? %>
                <div class="flex flex-wrap gap-1.5 justify-center">
                  <% @teacher.subjects_tags.each do |tag| %>
                    <span class="badge badge-sm bg-[#fe6618]/10 text-[#fe6618] border-[#fe6618]/20"><%= format_subject_tag(tag) %></span>
                  <% end %>
                </div>
              <% end %>

              <!-- Texte Niveaux (pas de labels CAPS) -->
              <% if @teacher.levels.present? %>
                <div class="text-xs text-gray-600 text-center">
                  <%= @teacher.levels.map { |level| format_level_tag(level) }.join(" • ") %>
                </div>
              <% end %>
            </div>

            <!-- CTA principal (uniquement pour les parents) -->
            <% if current_user.parent? %>
              <% parent_profile = current_user.parent_profile %>
              <% if parent_profile %>
                <% if @has_active_request %>
                  <button disabled class="btn btn-disabled bg-gray-300 text-gray-600 border-gray-300 rounded-lg w-full mb-2 cursor-not-allowed">
                    Professeur déjà contacté
                  </button>
                <% else %>
                  <button onclick="request_modal.showModal()" class="btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white rounded-lg w-full mb-2">
                    Demander une mise en relation
                  </button>
                <% end %>
                <div class="text-center space-y-1">
                  <p class="text-xs text-gray-500">Coordonnées partagées après acceptation</p>
                  <p class="text-xs text-gray-500">Réponse sous 24–48h</p>
                </div>
              <% else %>
                <%= link_to "Compléter mon profil pour créer une demande", parent_profile_path, class: "btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white rounded-lg w-full mb-2" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Colonne droite (2/3) - Contenu continu -->
      <div class="lg:col-span-2">
        <div class="card bg-white shadow-sm">
          <div class="card-body space-y-8">
            <!-- Section 1 — Infos pratiques -->
            <div>
              <h2 class="text-2xl font-semibold text-gray-900 mb-4">Infos pratiques</h2>
              <div class="space-y-4 text-gray-700">
                <!-- Formats de cours -->
                <% if @teacher.teaching_formats.present? %>
                  <p><%= format_teaching_formats_sentence(@teacher.teaching_formats, @teacher.gender) %></p>
                <% end %>

                <!-- Localisation -->
                <% if @teacher.city.present? %>
                  <p>
                    Je suis basé<% if @teacher.gender == "female" %>e<% end %>
                    à <strong><%= @teacher.city %></strong>
                    <% if @teacher.zip_code.present? %>
                      (<%= @teacher.zip_code %>)
                    <% end %>.
                  </p>
                <% end %>

                <!-- Tarif -->
                <% if @teacher.pricing_text.present? %>
                  <p>
                    Cours particuliers à
                    <% price_match = @teacher.pricing_text.match(/(\d+)\s*€/) %>
                    <strong><%= price_match ? "#{price_match[1]} € / heure" : format_pricing_text(@teacher.pricing_text) %></strong>.
                  </p>
                <% end %>
              </div>
            </div>

            <!-- Section 2 — Mon accompagnement -->
            <% if @teacher.support_text.present? || @teacher.pedagogy_tags.present? %>
              <div>
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">Mon accompagnement</h2>

                <%# Afficher support_text comme texte libre s'il existe %>
                <% if @teacher.support_text.present? %>
                  <p class="text-gray-700 mb-4"><%= @teacher.support_text %></p>
                <% end %>

                <%# Afficher pedagogy_tags comme liste à puces %>
                <% if @teacher.pedagogy_tags.present? %>
                  <ul class="space-y-2">
                    <% @teacher.pedagogy_tags.each do |tag| %>
                      <li class="flex items-start gap-2">
                        <svg class="w-5 h-5 text-[#fe6618] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span class="text-gray-700"><%= format_pedagogy_tag(tag) %></span>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            <% end %>

            <!-- Section 3 — Examens préparés -->
            <% if @teacher.exam_tags.present? %>
              <div>
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">Examens préparés</h2>
                <div class="flex flex-wrap gap-2">
                  <% @teacher.exam_tags.each do |tag| %>
                    <span class="badge badge-sm bg-purple-100 text-purple-700 border-purple-200"><%= format_exam_tag(tag) %></span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Section 4 — Expérience -->
            <% if @teacher.experience_text.present? %>
              <div>
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">Expérience</h2>
                <%# Texte fluide, pas une liste %>
                <%# Prendre la première phrase/ligne comme résumé fluide %>
                <% experience_clean = @teacher.experience_text.strip.gsub(/\n+/, " ").gsub(/\s+/, " ") %>
                <p class="text-gray-700"><%= experience_clean %></p>
              </div>
            <% end %>

            <!-- Section 5 — Compétences pédagogiques -->
            <% if @teacher.special_skills_text.present? && @teacher.special_skills_text.strip.length > 20 %>
              <div>
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">Compétences pédagogiques</h2>
                <%# Courte liste ou phrase %>
                <p class="text-gray-700 whitespace-pre-line"><%= @teacher.special_skills_text %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Aperçu limité pour les utilisateurs non connectés -->
    <div class="card bg-white shadow-sm">
      <div class="card-body text-center py-12">
        <div class="flex justify-center mb-6">
          <%= render "shared/teacher_avatar", teacher: @teacher, size: :large, for_parent: true %>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mb-4">
          <%= teacher_short_name(@teacher) %>
        </h1>
        <p class="text-gray-600 mb-6">Inscrivez-vous gratuitement pour voir la fiche complète de ce professeur et demander une mise en relation.</p>
      </div>
    </div>
  <% end %>
</div>

<% if user_signed_in? && current_user.parent? %>
  <% parent_profile = current_user.parent_profile %>
  <% if parent_profile %>
    <%
      # Initialiser les variables de formulaire (pour préserver les valeurs en cas d'erreur)
      @form_student_id ||= nil
      @form_student_attributes ||= {}
      @form_subject ||= nil
      @form_level ||= nil
      @form_notes ||= nil
    %>
    <!-- Modal pour créer une demande -->
    <dialog id="request_modal" class="modal <%= 'modal-open' if flash[:alert].present? %>">
      <div class="modal-box">
        <h3 class="font-bold text-2xl mb-2">Mise en relation</h3>
        <p class="text-gray-600 mb-4">Ajouter des informations sur votre enfant et ses besoins pour aider <%= @teacher.first_name.presence || "ce professeur" %> à comprendre vos attentes.</p>

        <!-- Messages d'erreur -->
        <% if flash[:alert].present? %>
          <div class="alert alert-error mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><%= flash[:alert] %></span>
          </div>
        <% end %>

        <%= form_with url: requests_path, local: true, class: "space-y-4", data: { controller: "student-selector", student_selector_students_value: parent_profile.students.map { |s| { id: s.id, level: s.level, age: s.age, birth_year: s.birth_year } }.to_json } do |f| %>
          <%= hidden_field_tag :teacher_id, @teacher.id %>

          <!-- Section Enfant -->
          <div class="form-control">
            <%= label_tag "request[student_id]", "Enfant", class: "label" do %>
              <span class="label-text">Pour quel enfant ? *</span>
            <% end %>

            <% if parent_profile.students.exists? %>
              <!-- Dropdown avec étudiants existants -->
              <%= select_tag "request[student_id]",
                  options_from_collection_for_select(parent_profile.students, :id, :first_name, @form_student_id) +
                  content_tag(:option, "Ajouter un enfant", value: "new", selected: (@form_student_id == "new")),
                  { prompt: "Sélectionnez un enfant",
                    class: "select select-bordered w-full",
                    required: true,
                    id: "student-select",
                    data: {
                      student_selector_target: "select",
                      action: "change->student-selector#toggle"
                    } } %>
            <% else %>
              <!-- Pas d'étudiants: afficher directement les champs de création -->
              <%= hidden_field_tag "request[student_id]", "new" %>
            <% end %>

          </div>

          <!-- Champs pour créer un nouvel élève (masqués par défaut si dropdown existe) -->
          <div class="form-control <%= 'hidden' if parent_profile.students.exists? && @form_student_id != "new" %>" data-student-selector-target="newFields">
            <div class="grid gap-4 md:grid-cols-2">
              <div class="form-control">
                <%= label_tag "request[student_attributes][first_name]", "Prénom", class: "label" do %>
                  <span class="label-text">Prénom *</span>
                <% end %>
                <%= text_field_tag "request[student_attributes][first_name]", @form_student_attributes[:first_name],
                    class: "input input-bordered w-full",
                    required: true,
                    placeholder: "Prénom",
                    data: { student_selector_target: "firstNameInput" } %>
              </div>
              <div class="form-control">
                <%= label_tag "request[student_attributes][birth_year]", "Année de naissance", class: "label" do %>
                  <span class="label-text">Année de naissance *</span>
                <% end %>
                <%= number_field_tag "request[student_attributes][birth_year]", @form_student_attributes[:birth_year],
                    class: "input input-bordered w-full",
                    min: 1900,
                    max: Date.current.year,
                    required: true,
                    placeholder: Date.current.year.to_s,
                    data: {
                      student_selector_target: "birthYearInput",
                      action: "change->student-selector#updateLevelFromBirthYear"
                    } %>
              </div>
            </div>
          </div>

          <div class="form-control">
            <%= label_tag "request[level]", "Niveau", class: "label" do %>
              <span class="label-text">Quel niveau ? *</span>
            <% end %>
            <%= select_tag "request[level]",
                options_for_select(RequestsHelper::LEVELS_OPTIONS, @form_level),
                { class: "select select-bordered w-full",
                  required: true,
                  data: { student_selector_target: "levelDisplay" },
                  id: "request_level" } %>
          </div>

          <div class="form-control">
            <%= f.label :subject, class: "label" do %>
              <span class="label-text">Pour quelle matière ? *</span>
            <% end %>
            <%= select_tag "request[subject]", options_for_select(TeachersHelper::SUBJECTS_OPTIONS, @form_subject), { prompt: "Sélectionnez une matière", class: "select select-bordered w-full", required: true } %>
          </div>

          <div class="form-control">
            <%= label_tag "request[notes]", "Notes", class: "label" do %>
              <span class="label-text">Précisez votre demande (optionnel)</span>
            <% end %>
            <%= text_area_tag "request[notes]", @form_notes, class: "textarea textarea-bordered w-full h-24", placeholder: "Ajouter des info sur votre enfant, ses difficultés, ce que vous recherchez exactement" %>
          </div>

          <div class="modal-action">
            <button type="button" onclick="request_modal.close()" class="btn btn-ghost">Annuler</button>
            <%= f.submit "Envoyer la demande", class: "btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white" %>
          </div>
        <% end %>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <script>
      // Ouvrir le modal automatiquement s'il y a des erreurs
      <% if flash[:alert].present? %>
        document.addEventListener('DOMContentLoaded', function() {
          const modal = document.getElementById('request_modal');
          if (modal) {
            modal.showModal();
          }
        });
      <% end %>
    </script>
  <% end %>
<% end %>
