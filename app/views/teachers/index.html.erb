<div class="container mx-auto max-w-6xl px-4 py-12">
  <div class="space-y-6">
    <!-- Filtres -->
    <div class="card bg-white shadow-sm">
      <div class="card-body">
        <h1 class="text-xl font-bold text-gray-900 mb-4">Trouvez le bon professeur</h1>
        <%= form_with url: teachers_path, method: :get, local: true,
            data: { controller: "form", turbo_frame: "teachers_list", turbo_action: "replace" },
            class: "flex flex-wrap gap-4 items-end" do |f| %>
          <div class="form-control flex-1 min-w-[200px]">
            <%= f.label :level, "Niveau", class: "label" %>
            <%= f.select :level, options_for_select([["Tous les niveaux", ""]] + TeachersHelper::LEVELS_OPTIONS, params[:level]), {},
                { class: "select select-bordered w-full",
                  data: { action: "change->form#submit" } } %>
          </div>
          <div class="form-control flex-1 min-w-[200px]">
            <%= f.label :subject, "Matière", class: "label" %>
            <%= f.select :subject, options_for_select([["Toutes les matières", ""]] + TeachersHelper::SUBJECTS_OPTIONS, params[:subject]), {},
                { class: "select select-bordered w-full",
                  data: { action: "change->form#submit" } } %>
          </div>
          <div class="form-control flex-1 min-w-[200px]">
            <%= f.label :city, "Ville", class: "label" %>
            <%= f.select :city, options_for_select(TeachersHelper::CITIES_OPTIONS, params[:city]), {},
                { class: "select select-bordered w-full",
                  data: { action: "change->form#submit" } } %>
          </div>
          <div class="form-control flex-1 min-w-[200px]">
            <%= f.label :format, "Format", class: "label" %>
            <%= f.select :format, options_for_select([
              ["Tous les formats", ""],
              ["Au domicile de l'élève", "at_student_home"],
              ["Au domicile du professeur", "at_teacher_home"],
              ["Online", "online"]
            ], params[:format]), {},
                { class: "select select-bordered w-full",
                  data: { action: "change->form#submit" } } %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Liste des professeurs dans un Turbo Frame -->
    <%= turbo_frame_tag "teachers_list" do %>
      <%= render "teachers_list" %>
    <% end %>
  </div>
</div>
