<% content_for :main_background, "background-color: oklch(0.985 0.002 247.839);" %>
<% content_for(:description) { "Trouvez un professeur certifié en maths, français, anglais ou en sciences, pour des cours particuliers adaptés au niveau de votre enfant." } %>
<%
  # Meta title dynamique selon les filtres
  if params[:subject].present? || params[:city].present?
    title_parts = ["Cours particuliers"]
    title_parts << "en #{format_subject_tag(params[:subject])}" if params[:subject].present?
    title_parts << "à #{params[:city]}" if params[:city].present?
    page_title = "#{title_parts.join(' ')} | ProfConnect"
  else
    page_title = "Cours particuliers avec professeurs de l'Éducation Nationale | ProfConnect"
  end
%>
<% content_for(:title) { page_title } %>

<div class="container mx-auto max-w-6xl px-4 py-12">
  <div class="space-y-6">
    <!-- Filtres -->
    <div class="card bg-white shadow-sm">
      <div class="card-body">
        <h1 class="text-2xl font-bold text-gray-900 mb-4">Trouvez le bon professeur</h1>
        <%= form_with url: teachers_path, method: :get, local: true,
            data: { controller: "form format-filter", turbo_frame: "teachers_list", turbo_action: "replace" },
            class: "flex flex-wrap gap-4 items-end" do |f| %>
          <div class="form-control flex-1 min-w-[200px]">
            <%= f.label :level, "Niveau", class: "label" %>
            <%= f.select :level, options_for_select([["Tous les niveaux", ""]] + TeachersHelper::LEVELS_OPTIONS, params[:level]), {},
                { class: "select select-bordered w-full",
                  data: { action: "change->form#submit" } } %>
          </div>
          <div class="form-control flex-1 min-w-[200px]">
            <%= f.label :subject, "Matière", class: "label" %>
            <%= f.select :subject, options_for_select([["Toutes les matières", ""]] + TeachersHelper::SUBJECTS_OPTIONS, params[:subject]), {},
                { class: "select select-bordered w-full",
                  data: { action: "change->form#submit" } } %>
          </div>
          <div class="form-control flex-1 min-w-[200px]">
            <%= f.label :format, "Format", class: "label" %>
            <%= f.select :format, options_for_select([
              ["Tous les formats", ""],
              ["Chez l'élève", "at_student_home"],
              ["Au domicile du professeur", "at_teacher_home"],
              ["En ligne", "online"]
            ], params[:format]), {},
                { class: "select select-bordered w-full",
                  id: "format-select",
                  data: {
                    format_filter_target: "format",
                    action: "change->format-filter#formatChanged change->form#submit"
                  } } %>
          </div>
          <div class="form-control flex-1 min-w-[200px]"
               data-controller="zone-selector"
               data-zone-selector-initial-zones-value="<%= initial_served_zones.to_json %>"
               data-zone-selector-all-zones-value="<%= all_served_zones_for_search.to_json %>"
               data-zone-selector-selected-value="<%= (params[:zones] ? [params[:zones]] : []).to_json %>"
               data-zone-selector-single-select-value="true"
               data-format-filter-target="city">
            <%= f.label :zones, "Ville ou département", class: "label" %>
            <% zones_disabled = params[:format] == "online" %>
            <%= hidden_field_tag "zones", params[:zones] || "", data: { zone_selector_target: "input" } %>
            <div class="relative">
              <input type="text"
                     placeholder="Sélectionnez une zone"
                     data-zone-selector-target="searchInput"
                     data-action="input->zone-selector#search focus->zone-selector#toggleDropdown keydown->zone-selector#handleKeydown"
                     class="input input-bordered w-full <%= zones_disabled ? 'opacity-50 cursor-not-allowed' : '' %>"
                     disabled="<%= zones_disabled %>" />
              <div data-zone-selector-target="dropdown" class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-96 overflow-y-auto">
                <!-- Contenu généré par JavaScript -->
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Liste des professeurs dans un Turbo Frame -->
    <%= turbo_frame_tag "teachers_list" do %>
      <%= render "teachers_list" %>
    <% end %>
  </div>
</div>
