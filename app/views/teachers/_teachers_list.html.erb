<div class="text-sm text-gray-400 mb-4">
  <%= @teachers.count %> professeur<%= @teachers.count > 1 ? "s" : "" %> trouvé<%= @teachers.count > 1 ? "s" : "" %>
</div>

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  <% @teachers.each do |teacher| %>
    <div class="card bg-white shadow-sm hover:shadow-md transition">
      <div class="card-body">
        <div class="flex items-start gap-4 mb-4">
          <%= render "shared/teacher_avatar", teacher: teacher, size: :medium, for_parent: true %>
          <div class="flex-1">
            <h3 class="card-title text-xl"><%= teacher_short_name(teacher) %></h3>
            <% if teacher.academy_name.present? %>
              <p class="text-sm text-gray-600"><%= teacher.academy_name %></p>
            <% end %>
            <% if teacher.career_status.present? %>
              <p class="text-xs text-gray-500 mt-1"><%= teacher.career_status.humanize %></p>
            <% end %>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mt-2">
          <% if teacher.levels.present? %>
            <% teacher.levels.each do |level| %>
              <span class="badge badge-sm bg-orange-100 text-orange-700 border-orange-200"><%= format_level_tag(level) %></span>
            <% end %>
          <% end %>
          <% if teacher.subjects_tags.present? %>
            <% teacher.subjects_tags.first(4).each do |tag| %>
              <span class="badge badge-sm bg-blue-100 text-blue-700 border-blue-200"><%= format_subject_tag(tag) %></span>
            <% end %>
            <% if teacher.subjects_tags.length > 4 %>
              <span class="badge badge-sm bg-blue-100 text-blue-700 border-blue-200">+<%= teacher.subjects_tags.length - 4 %></span>
            <% end %>
          <% end %>
        </div>

        <div class="mt-4 space-y-2">
          <% if teacher.teaching_formats.present? %>
            <p class="text-sm text-gray-600">
              <span class="font-semibold">Formats :</span> <%= format_teaching_formats(teacher.teaching_formats) %>
            </p>
          <% end %>

          <% if teacher.pricing_text.present? %>
            <p class="text-sm font-semibold text-blue-600"><%= format_pricing_text(teacher.pricing_text) %></p>
          <% end %>
        </div>

        <% if teacher.experience_text.present? || teacher.support_text.present? %>
          <p class="text-gray-600 mt-4 line-clamp-2 text-sm">
            <% if teacher.experience_text.present? %>
              <%= truncate(teacher.experience_text, length: 100) %>
            <% elsif teacher.support_text.present? %>
              <%= truncate(teacher.support_text, length: 100) %>
            <% end %>
          </p>
        <% end %>

        <div class="card-actions justify-end mt-4">
          <%= link_to "Voir le profil", teacher_path(teacher),
              class: "btn btn-primary bg-blue-600 hover:bg-blue-700 border-blue-600 text-white rounded-lg btn-sm",
              data: { turbo_frame: "_top" } %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @teachers.empty? %>
  <div class="text-center py-12">
    <p class="text-gray-600">Aucun professeur disponible pour le moment.</p>
  </div>
<% end %>
