<% content_for(:title) { "ProfConnect | Cours particuliers avec professeurs de l'Éducation nationale" } %>

<div class="min-h-screen bg-white text-gray-900">
  <!-- Header -->
  <% if user_signed_in? %>
    <!-- Navbar version loggé (utilise le layout authenticated) -->
    <header class="sticky top-0 z-50 bg-white border-b border-stone-200">
      <div class="navbar max-w-7xl mx-auto px-4 md:px-6">
        <div class="flex-1">
          <%= link_to root_path, class: "flex items-center space-x-2" do %>
            <%= image_tag "logo.png", alt: "ProfConnect", style: "height: 50px; width: auto;" %>
          <% end %>
        </div>
        <div class="flex-none gap-6 items-center">
          <%= render "shared/navbar_logged_in" %>
        </div>
      </div>
    </header>
  <% else %>
    <!-- Navbar version non loggé -->
    <header class="sticky top-0 z-50 bg-white border-b border-stone-200">
      <div class="navbar max-w-7xl mx-auto px-4 md:px-6">
        <div class="flex-1">
          <%= link_to root_path, class: "flex items-center space-x-2" do %>
            <%= image_tag "logo.png", alt: "ProfConnect", style: "height: 50px; width: auto;" %>
          <% end %>
        </div>
        <div class="flex-none gap-6 items-center hidden lg:flex">
          <%= link_to "Pourquoi ProfConnect ?", "#pourquoi", class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
          <%= link_to "FAQ", "#faq", class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
        </div>
        <div class="flex-none lg:hidden">
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Ouvrir la navigation">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </label>
            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-10 p-4 shadow bg-white rounded-box w-56 space-y-2">
              <li><%= link_to "Pourquoi ProfConnect ?", "#pourquoi", class: "text-sm text-gray-700 hover:text-[#fe6618]" %></li>
              <li><%= link_to "FAQ", "#faq", class: "text-sm text-gray-700 hover:text-[#fe6618]" %></li>
            </ul>
          </div>
        </div>
      </div>
    </header>
  <% end %>

  <main>
    <!-- Hero -->
    <section id="hero" class="py-12 md:py-16 bg-gradient-to-b from-white to-[#fff9f5] hero-section-pattern">
      <div class="container mx-auto max-w-6xl px-6">
        <div class="grid gap-12 md:grid-cols-2 md:items-center">
          <div class="space-y-6">
            <h1 id="hero-title" class="text-5xl font-extrabold leading-none md:leading-tight text-gray-900">
              <span class="hero-word">Des</span> <span class="hero-word">professeurs</span> <span class="hero-word">de</span>
              <span class="relative inline-block hero-word">
                <span class="relative z-10 bg-gradient-to-r from-[#e05a1a] to-[#fe6618] bg-clip-text text-transparent">l'Éducation Nationale</span>
              </span>
              <span class="hero-word">disponibles</span> <span class="hero-word">pour</span> <span class="hero-word">votre</span> <span class="hero-word">enfant.</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-600 leading-relaxed">Le sérieux de l'école, la proximité du cours particulier.</p>
            <p class="text-base md:text-sm text-gray-500">Plus de 500 professeurs diplômés de l'Éducation Nationale, partout en France.</p>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#fe6618]/10 border border-[#fe6618]/20 rounded-lg">
              <span class="text-xs md:text-sm font-medium text-[#fe6618]">Inscrivez-vous gratuitement sur ProfConnect</span>
            </div>
            <div class="flex flex-wrap gap-3">
              <%= link_to new_parent_registration_path,
                  class: "btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white rounded-lg shadow-md hover:shadow-lg transition-shadow",
                  "aria-label": "Découvrir ProfConnect pour les parents" do %>
                Je suis parent
              <% end %>
              <%= link_to new_teacher_registration_path,
                  class: "btn bg-white border border-stone-300 text-gray-900 hover:bg-stone-50 rounded-lg shadow-md hover:shadow-lg transition-shadow",
                  "aria-label": "Rejoindre ProfConnect en tant que professeur" do %>
                Je suis professeur
              <% end %>
            </div>
          </div>
          <div class="w-full">
            <%= image_tag "home-hero.jpg",
                alt: "Parent et élève recherchant un professeur certifié sur ProfConnect",
                class: "w-full rounded-xl object-cover" %>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission -->
    <section class="py-20 md:py-24 bg-gradient-to-b from-[#fff9f5] to-white">
      <div class="container mx-auto max-w-6xl px-6">
        <div class="grid gap-12 md:grid-cols-2 md:items-start">
          <div class="space-y-4">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Les professeurs passionnés méritent mieux qu'un job étudiant.</h2>
            <p class="text-gray-600 leading-relaxed">
              De nombreux enseignants de l'Éducation Nationale veulent transmettre au-delà de leur classe, pour le plaisir d'enseigner et pour compléter leur revenu.
              ProfConnect leur donne cette place : un espace simple, sérieux et valorisant, dédié aux professeurs diplômés de l'Éducation Nationale.
            </p>
          </div>
          <div class="space-y-4">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">La réussite de votre enfant mérite le savoir-faire d'un enseignant passionné</h2>
            <p class="text-gray-600 leading-relaxed">
              Les parents souhaitent que leurs enfants bénéficient de cours de qualité, transmis par des professeurs expérimentés, pédagogues et connaisseurs des programmes scolaires et des modalités d'examens. ProfConnect est pensé pour eux : nos professeurs sont sélectionnés sur la base de leur parcours pédagogique, pour offrir à chaque élève un accompagnement personnalisé, efficace et motivant, à même de révéler tout son potentiel.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pourquoi ProfConnect -->
    <section id="pourquoi" class="py-20 md:py-24 bg-white">
      <div class="container mx-auto max-w-6xl px-6 space-y-10">
        <div class="max-w-3xl space-y-3">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Pourquoi choisir ProfConnect ?</h2>
          <p class="text-gray-600 leading-relaxed">Nous sélectionnons des professeurs de métier, pour des progrès réels et durables.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          <div class="card bg-white border border-[#fe6618]/30 shadow-sm hover:bg-gray-50 hover:shadow-sm transition">
            <div class="card-body space-y-3">
              <div class="flex items-center gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full border-2 border-[#fe6618] bg-transparent flex items-center justify-center">
                  <%= heroicon_tag 'check', variant: :outline, class: "w-5 h-5 text-[#fe6618]", "stroke-width": 2.5 %>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Professeurs diplômés de l'Éducation Nationale, tous certifiés ou agrégés</h3>
              </div>
              <p class="text-gray-600 leading-relaxed">100% des enseignants de la plateforme sont titulaires ou retraités de l'Éducation Nationale et maîtrisent les programmes pour lesquels ils proposent leurs enseignements.</p>
            </div>
          </div>
          <div class="card bg-white border border-[#fe6618]/30 shadow-sm hover:bg-gray-50 hover:shadow-sm transition">
            <div class="card-body space-y-3">
              <div class="flex items-center gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full border-2 border-[#fe6618] bg-transparent flex items-center justify-center">
                  <%= heroicon_tag 'check', variant: :outline, class: "w-5 h-5 text-[#fe6618]", "stroke-width": 2.5 %>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Préparation des examens et des grandes étapes de la scolarité</h3>
              </div>
              <p class="text-gray-600 leading-relaxed">Brevet, Baccalauréat, Parcoursup : des professeurs qui maîtrisent les programmes, les méthodes et les épreuves.</p>
            </div>
          </div>
          <div class="card bg-white border border-[#fe6618]/30 shadow-sm hover:bg-gray-50 hover:shadow-sm transition">
            <div class="card-body space-y-3">
              <div class="flex items-center gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full border-2 border-[#fe6618] bg-transparent flex items-center justify-center">
                  <%= heroicon_tag 'check', variant: :outline, class: "w-5 h-5 text-[#fe6618]", "stroke-width": 2.5 %>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Suivi personnalisé et pédagogie adaptée</h3>
              </div>
              <p class="text-gray-600 leading-relaxed">Chaque élève bénéficie d'un accompagnement sur mesure pour favoriser sa réussite selon son profil et ses besoins.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trouver le professeur idéal -->
    <section class="py-20 md:py-24 bg-white">
      <div class="container mx-auto max-w-6xl px-6 grid gap-12 md:grid-cols-2 md:items-center">
        <div class="space-y-5">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Rencontrez le bon professeur pour votre enfant.</h2>
          <p class="text-gray-600 leading-relaxed">
            En quelques clics, filtrez par matière, niveau et localisation. Vous pourrez également définir avec le professeur, la fréquence, la durée et les modalités d'organisation des cours (qui pourront être organisés au domicile de l'élève, au domicile du professeur ou à distance).
          </p>
          <%= link_to "Voir les professeurs →", "/teachers", class: "inline-flex items-center text-[#fe6618] hover:text-[#d85514] font-semibold text-lg transition-colors" %>
        </div>
        <div>
          <%= image_tag "home-search.jpg",
              alt: "Interface ProfConnect pour trouver un professeur certifié",
              class: "w-full rounded-xl object-cover" %>
        </div>
      </div>
    </section>

    <!-- Quelques professeurs certifiés -->
    <section class="py-20 md:py-24 bg-gradient-to-b from-[#fff9f5] to-white">
      <div class="container mx-auto max-w-6xl px-6 space-y-10">
        <div class="space-y-3 text-center md:text-left">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Nos professeurs, tous issus de l'Éducation Nationale.</h2>
          <p class="text-gray-600 leading-relaxed">Une sélection d’enseignants disponibles pour accompagner votre enfant.</p>
          <div class="flex flex-wrap justify-center md:justify-start gap-4 text-sm">
            <%= link_to "Maths", teachers_path(subject: "mathematiques"), class: "text-[#fe6618] hover:underline" %>
            <%= link_to "Français", teachers_path(subject: "francais"), class: "text-[#fe6618] hover:underline" %>
            <%= link_to "Physique", teachers_path(subject: "physique-chimie"), class: "text-[#fe6618] hover:underline" %>
            <%= link_to "Histoire-Géo", teachers_path(subject: "histoire-geographie"), class: "text-[#fe6618] hover:underline" %>
          </div>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          <% teachers = [
            { name: "Claire M.", subject: "Français", academy: "Académie de Paris", badges: ["Parcoursup", "Bac français"], summary: "Professeure certifiée, littérature et méthodologie pour lycéens et étudiants." },
            { name: "Ahmed B.", subject: "Mathématiques", academy: "Académie de Lyon", badges: ["Brevet", "Bac S"], summary: "Enseignant de lycée, remise à niveau et préparation intensive en maths." },
            { name: "Sophie L.", subject: "Physique-Chimie", academy: "Académie de Toulouse", badges: ["Laboratoire", "Bac STI2D"], summary: "Professeure titulaire, approche expérimentale et coaching aux épreuves pratiques." }
          ] %>
          <% teachers.each do |teacher| %>
            <div class="card bg-white border border-stone-200 shadow-sm ">
              <div class="card-body space-y-4 text-center">
                <%= image_tag "teacher.jpg", alt: "#{teacher[:name]} – professeur certifié", class: "h-32 w-32 mx-auto rounded-full object-cover shadow-md" %>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900"><%= teacher[:name] %></h3>
                  <p class="text-sm text-gray-600"><%= teacher[:subject] %> · <%= teacher[:academy] %></p>
                </div>
                <div class="flex flex-wrap justify-center gap-2">
                  <% teacher[:badges].take(2).each do |badge| %>
                    <span class="badge badge-outline"><%= badge %></span>
                  <% end %>
                </div>
                <p class="text-gray-600 leading-relaxed"><%= teacher[:summary] %></p>
                <%= link_to "Voir ce professeur", "/teachers", class: "btn bg-white border border-stone-300 text-gray-900 hover:bg-stone-50 rounded-lg", "aria-label": "Voir le profil de #{teacher[:name]}" %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="text-center pt-4">
          <%= link_to "Découvrir tous les professeurs", teachers_path, class: "btn bg-[#fe6618] hover:bg-[#e55a15] text-white border-none rounded-lg px-8 py-3" %>
        </div>
      </div>
    </section>

    <!-- Ils nous font confiance -->
    <section class="py-20 md:py-24 bg-gradient-to-b from-[#fff9f5] to-white">
      <div class="container mx-auto max-w-7xl px-6 space-y-10">
        <div class="max-w-3xl space-y-3">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Ils nous font confiance</h2>
          <p class="text-gray-600 leading-relaxed">Parents et professeurs partagent leur expérience avec ProfConnect.</p>
        </div>
        <div class="relative px-8 md:px-12">
          <div class="overflow-hidden">
            <div id="testimonials-carousel" class="flex gap-6 transition-transform duration-500 ease-in-out">
            <% testimonials = [
              {
                quote: "J'ai trouvé un professeur de mathématiques génial pour mon fils de 3ème. Il enseigne lui-même en classe de 3ème et il connaît parfaitement le programme et les difficultés des élèves",
                author: "Parent de Mathieu, 14 ans",
                rating: 5
              },
              {
                quote: "Pour préparer le bac de français cette année, ma fille a bénéficié de l'accompagnement d'un professeur correcteur du baccalauréat. Ça change tout dans la préparation !",
                author: "Parent de Lila, 16 ans",
                rating: 5
              },
              {
                quote: "ProfConnect est une plateforme sérieuse et professionnelle. En tant qu'enseignante expérimentée, je suis heureuse d'avoir trouvé une plateforme vraiment dédiée aux professeurs de l'Éducation Nationale.",
                author: "Nadine, professeure de Mathématiques au Lycée",
                rating: 5
              },
              {
                quote: "J'ai trouvé un professeur de mathématiques génial pour mon fils de 3ème. Il enseigne lui-même en classe de 3ème et il connaît parfaitement le programme et les difficultés des élèves",
                author: "Parent de Mathieu, 14 ans",
                rating: 5
              },
              {
                quote: "Pour préparer le bac de français cette année, ma fille a bénéficié de l'accompagnement d'un professeur correcteur du baccalauréat. Ça change tout dans la préparation !",
                author: "Parent de Lila, 16 ans",
                rating: 5
              },
              {
                quote: "ProfConnect est une plateforme sérieuse et professionnelle. En tant qu'enseignante expérimentée, je suis heureuse d'avoir trouvé une plateforme vraiment dédiée aux professeurs de l'Éducation Nationale.",
                author: "Nadine, professeure de Mathématiques au Lycée",
                rating: 5
              }
            ] %>
            <% testimonials.each do |testimonial| %>
              <div class="flex-shrink-0 w-full md:w-1/3">
                <div class="card bg-white border border-stone-200 shadow-sm h-full">
                  <div class="card-body space-y-4">
                    <!-- Étoiles Trustpilot style -->
                    <div class="flex gap-1">
                      <% 5.times do |i| %>
                        <svg class="w-5 h-5 <%= i < testimonial[:rating] ? 'text-yellow-400' : 'text-gray-300' %>" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      <% end %>
                    </div>
                    <p class="text-gray-600 leading-relaxed">"<%= testimonial[:quote] %>"</p>
                    <p class="text-sm font-medium text-gray-900">— <%= testimonial[:author] %></p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          <!-- Boutons de navigation -->
          <button id="testimonials-prev" class="absolute left-0 top-1/2 -translate-y-1/2 bg-white border border-stone-300 rounded-full p-2 shadow-md hover:bg-stone-50 transition-colors z-30 hidden md:flex items-center justify-center">
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button id="testimonials-next" class="absolute right-0 top-1/2 -translate-y-1/2 bg-white border border-stone-300 rounded-full p-2 shadow-md hover:bg-stone-50 transition-colors z-30 hidden md:flex items-center justify-center">
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
        <!-- Indicateurs de pagination -->
        <div class="flex justify-center gap-2 mt-8">
          <% 6.times do |i| %>
            <button class="testimonial-dot w-2 h-2 rounded-full bg-gray-300 transition-all <%= 'bg-[#fe6618] w-6' if i == 0 %>" data-index="<%= i %>"></button>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Équipe -->
    <section class="py-20 md:py-24 bg-white">
      <div class="container mx-auto max-w-6xl px-6">
        <div class="mb-10 text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">L'équipe ProfConnect : trois fondateurs passionnés d'éducation, au service des professeurs et des familles</h2>
        </div>
        <div class="grid gap-8 md:grid-cols-3">
          <article class="card bg-white border border-stone-200 shadow-sm ">
            <div class="card-body space-y-4">
              <div class="text-center">
                <%= image_tag "gaelle.jpeg", alt: "Gaëlle Bailly-Maître Léonardon, cofondatrice de ProfConnect", class: "h-32 w-32 mx-auto rounded-full object-cover shadow-md" %>
              </div>
              <div class="space-y-3">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Gaëlle Bailly-Maître Léonardon</h3>
                  <p class="text-sm font-medium text-[#fe6618]">Co-fondatrice, Directrice pédagogique</p>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Professeure agrégée d'Histoire depuis plus de 20 ans, Gaëlle est la garante de l'excellence pédagogique. Elle a contribué à des manuels de référence et aux programmes nationaux. Elle veille à ce que chaque professeur réponde aux standards les plus élevés de l'Éducation nationale.
                </p>
              </div>
            </div>
          </article>
          <article class="card bg-white border border-stone-200 shadow-sm ">
            <div class="card-body space-y-4">
              <div class="text-center">
                <%= image_tag "boris.jpeg", alt: "Boris Paillard, cofondateur de ProfConnect", class: "h-32 w-32 mx-auto rounded-full object-cover shadow-md" %>
              </div>
              <div class="space-y-3">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Boris Paillard</h3>
                  <p class="text-sm font-medium text-[#fe6618]">Co-fondateur, Opérations & Produit</p>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Ancien CEO de Le Wagon, Boris a bâti des plateformes éducatives à grande échelle. Il met aujourd'hui son expertise produit et tech au service d'une expérience simple, fiable et centrée sur les enseignants et les familles.
                </p>
              </div>
            </div>
          </article>
          <article class="card bg-white border border-stone-200 shadow-sm ">
            <div class="card-body space-y-4">
              <div class="text-center">
                <%= image_tag "maxime.jpeg", alt: "Maxime, cofondateur de ProfConnect", class: "h-32 w-32 mx-auto rounded-full object-cover shadow-md" %>
              </div>
              <div class="space-y-3">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Maxime</h3>
                  <p class="text-sm font-medium text-[#fe6618]">Co-fondateur, Stratégie & Développement</p>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Entrepreneur tech expérimenté, Maxime pilote la stratégie et l'évolution de la plateforme. Il conçoit un modèle plus juste, sans commission, focalisé sur la qualité des enseignants et l'impact pour les familles.
                </p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA finale -->
    <section class="py-20 md:py-24 bg-gradient-to-r from-gray-900 to-black text-white">
      <div class="container mx-auto max-w-5xl px-6 text-center space-y-6 rounded-2xl py-16">
        <h2 class="text-3xl md:text-4xl font-bold">Offrez à votre enfant l'accompagnement qu'il mérite.</h2>
        <p class="text-white/90 leading-relaxed">Nos professeurs diplômés de l'Éducation Nationale accompagnent déjà plus de 500 familles partout en France.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <%= link_to "/teachers",
              class: "btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white rounded-lg",
              "aria-label": "Voir la liste des professeurs disponibles" do %>
            Voir les professeurs
          <% end %>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-20 md:py-24 bg-gradient-to-b from-[#fff9f5] to-white">
      <div class="container mx-auto max-w-6xl px-6 space-y-10">
        <div class="max-w-3xl space-y-3">
          <span class="inline-flex items-center rounded-full border border-stone-200 bg-[#fff9f5] px-4 py-1 text-sm font-medium text-gray-600">Questions fréquentes</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">FAQ</h2>
          <p class="text-gray-600 leading-relaxed">Les réponses clés pour comprendre ProfConnect.</p>
        </div>
        <!-- Notre Engagement Qualité -->
        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-gray-900">Notre Engagement Qualité</h3>
          <div class="join join-vertical w-full border border-stone-200 bg-white rounded-lg overflow-hidden">
            <div class="collapse collapse-arrow join-item bg-white">
              <input type="radio" name="faq-quality" id="faq-specificity" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Quelle est la spécificité de cette plateforme ?</div>
              <div class="collapse-content text-gray-600">Nous listons exclusivement des professeurs qui sont diplômés de l'Éducation Nationale (CAPES, Agrégation, CRPE, etc.). Notre objectif est de garantir aux élèves l'accès à un enseignement de la plus haute qualité.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-quality" id="faq-diploma" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Qu'est-ce qu'un professeur diplômé de l'Éducation Nationale ?</div>
              <div class="collapse-content text-gray-600">C'est un professionnel de l'enseignement qui a réussi un concours national (comme le CAPES ou l'Agrégation), attestant de sa maîtrise des programmes officiels et des méthodes pédagogiques reconnues en France.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-quality" id="faq-verification" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Comment vérifiez-vous les diplômes ?</div>
              <div class="collapse-content text-gray-600">Chaque justificatif de réussite au concours fourni par le professeur est vérifié manuellement par notre équipe avant la validation de son profil.</div>
            </div>
          </div>
        </div>

        <!-- Utilisation de la Plateforme -->
        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-gray-900">🔍 Utilisation de la Plateforme</h3>
          <div class="join join-vertical w-full border border-stone-200 bg-white rounded-lg overflow-hidden">
            <div class="collapse collapse-arrow join-item bg-white">
              <input type="radio" name="faq-usage" id="faq-subjects" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Quelles matières sont proposées ?</div>
              <div class="collapse-content text-gray-600">Nous couvrons l'ensemble des matières de l'enseignement général, du primaire au supérieur : Mathématiques, Français, Histoire-Géographie, Langues Vivantes (Anglais, Espagnol, etc.), Physique-Chimie, SVT, Philosophie, et bien d'autres.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-usage" id="faq-find" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Comment trouver le bon professeur ?</div>
              <div class="collapse-content text-gray-600">Utilisez notre moteur de recherche pour affiner vos résultats par matière, niveau scolaire (collège, lycée, supérieur) et type de cours (au domicile du professeur, au domicile de l'élève ou en ligne). Consultez les profils détaillés pour connaître l'expérience, la pédagogie et les disponibilités de chaque enseignant.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-usage" id="faq-contact" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Comment se fait la mise en relation ?</div>
              <div class="collapse-content text-gray-600">Une fois le profil idéal trouvé, vous le contactez directement via la plateforme pour échanger sur vos besoins et organiser le premier cours.</div>
            </div>
          </div>
        </div>

        <!-- Tarifs et Fonctionnement -->
        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-gray-900">💰 Tarifs et Fonctionnement</h3>
          <div class="join join-vertical w-full border border-stone-200 bg-white rounded-lg overflow-hidden">
            <div class="collapse collapse-arrow join-item bg-white">
              <input type="radio" name="faq-pricing" id="faq-free" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Est-ce que la plateforme est payante pour les familles (élèves/parents) ?</div>
              <div class="collapse-content text-gray-600">Non, l'utilisation de la plateforme est totalement gratuite pour les familles. La recherche, la consultation des profils et la mise en relation ne vous coûtent rien.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-pricing" id="faq-price" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Qui fixe le prix des cours ?</div>
              <div class="collapse-content text-gray-600">Le tarif horaire est fixé librement et intégralement par chaque professeur. Ce prix est affiché clairement sur leur profil.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-pricing" id="faq-commission" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Y a-t-il des commissions sur le prix des cours ?</div>
              <div class="collapse-content text-gray-600">Non, absolument aucune ! Que vous soyez élève/parent ou professeur, nous ne prélevons aucune commission sur le tarif horaire des cours. L'intégralité du paiement revient au professeur.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-pricing" id="faq-financing" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Comment la plateforme se finance-t-elle ?</div>
              <div class="collapse-content text-gray-600">La plateforme se finance par un système d'abonnement mensuel payé par les professeurs qui souhaitent être référencés et profiter de la visibilité auprès des familles.</div>
            </div>
            <div class="collapse collapse-arrow join-item bg-white border-t border-stone-200">
              <input type="radio" name="faq-pricing" id="faq-payment" />
              <div class="collapse-title text-lg font-semibold text-gray-900">Comment s'effectue le paiement des cours ?</div>
              <div class="collapse-content text-gray-600">Le paiement des cours se fait directement entre la famille et le professeur selon les modalités qu'ils auront définies ensemble. La plateforme n'intervient pas dans la transaction financière.</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-stone-200">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="text-lg font-semibold text-[#fe6618]">ProfConnect</div>
      <div class="flex flex-wrap gap-4 text-sm text-gray-600">
        <%= link_to "Pourquoi ProfConnect ?", "#pourquoi", class: "hover:text-[#fe6618]" %>
        <%= link_to "FAQ", "#faq", class: "hover:text-[#fe6618]" %>
        <a href="mailto:contact@prof-connect.fr" class="hover:text-[#fe6618]">contact@prof-connect.fr</a>
      </div>
    </div>
  </footer>
</div>

<script>
  (function() {
    function animateHeroTitle() {
      const heroTitle = document.getElementById('hero-title');
      if (!heroTitle) return;

      const words = heroTitle.querySelectorAll('.hero-word');
      words.forEach((word, index) => {
        setTimeout(() => {
          word.classList.add('animate');
        }, index * 60); // Stagger de 60ms entre chaque mot
      });
    }

    function initTestimonialsCarousel() {
      const carousel = document.getElementById('testimonials-carousel');
      const prevBtn = document.getElementById('testimonials-prev');
      const nextBtn = document.getElementById('testimonials-next');
      const dots = document.querySelectorAll('.testimonial-dot');

      if (!carousel || !prevBtn || !nextBtn) return;

      let currentIndex = 0;
      const totalItems = dots.length;

      // Calculer la largeur d'un item en fonction de l'écran
      function getItemWidth() {
        return window.innerWidth >= 768 ? 33.333 : 100; // 1/3 sur desktop, 100% sur mobile
      }

      function updateCarousel() {
        const itemWidth = getItemWidth();
        const translateX = -currentIndex * itemWidth;
        carousel.style.transform = `translateX(${translateX}%)`;

        // Mettre à jour les dots
        dots.forEach((dot, index) => {
          if (index === currentIndex) {
            dot.classList.add('bg-[#fe6618]', 'w-6');
            dot.classList.remove('bg-gray-300', 'w-2');
          } else {
            dot.classList.remove('bg-[#fe6618]', 'w-6');
            dot.classList.add('bg-gray-300', 'w-2');
          }
        });
      }

      function next() {
        currentIndex = (currentIndex + 1) % totalItems;
        updateCarousel();
      }

      function prev() {
        currentIndex = (currentIndex - 1 + totalItems) % totalItems;
        updateCarousel();
      }

      nextBtn.addEventListener('click', next);
      prevBtn.addEventListener('click', prev);

      // Navigation par dots
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          currentIndex = index;
          updateCarousel();
        });
      });

      // Recalculer sur resize
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          updateCarousel();
        }, 250);
      });

      // Auto-play (optionnel, défilement automatique toutes les 5 secondes)
      let autoPlayInterval = setInterval(next, 5000);

      // Pause au survol
      const carouselContainer = carousel.closest('.relative');
      if (carouselContainer) {
        carouselContainer.addEventListener('mouseenter', () => {
          clearInterval(autoPlayInterval);
        });
        carouselContainer.addEventListener('mouseleave', () => {
          autoPlayInterval = setInterval(next, 5000);
        });
      }

      // Initialiser
      updateCarousel();
    }

    // Initialisation au chargement
    function init() {
      animateHeroTitle();
      initTestimonialsCarousel();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Support pour Turbo
    document.addEventListener('turbo:load', init);
  })();
</script>
