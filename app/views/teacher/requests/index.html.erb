<% content_for :main_background, "background-color: oklch(0.985 0.002 247.839);" %>

<div class="max-w-7xl mx-auto h-[calc(100vh-4rem)] flex gap-6 px-4 md:px-6 py-4">
  <!-- Colonne gauche (1/3) - Liste des demandes -->
  <div class="flex-shrink-0 w-1/3 border-r border-gray-200 pr-6 flex flex-col">
    <div class="mb-6 flex-shrink-0">
      <h1 class="text-2xl font-bold text-gray-900">Demandes reçues</h1>
      <p class="text-sm text-gray-600 mt-1">Retrouvez toutes vos demandes de parents pour des cours particuliers</p>
    </div>

    <% if @requests.any? %>
      <div class="flex-1 overflow-y-auto space-y-2">
        <% @requests.each do |request| %>
          <%= link_to teacher_requests_path(id: request.id), class: "block" do %>
            <div class="p-4 rounded-lg bg-white border transition-colors <%= @active_request&.id == request.id ? 'border-[#fe6618] shadow-sm' : 'border-gray-200 hover:border-gray-300' %>">
              <div class="flex items-start justify-between mb-2">
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-gray-900 text-sm">
                    <% parent_profile = request.parent&.parent_profile %>
                    <% if request.status == "accepted" && parent_profile&.first_name.present? %>
                      <%= "#{parent_profile.first_name} #{parent_profile.last_name}" %>
                    <% elsif parent_profile&.first_name.present? %>
                      <%= "#{parent_profile.first_name} #{parent_profile.last_name&.first&.upcase}." if parent_profile.last_name.present? %>
                      <%= parent_profile.first_name unless parent_profile.last_name.present? %>
                    <% else %>
                      Parent
                    <% end %>
                  </h3>
                  <%# Preview du dernier message %>
                  <% last_message = request.messages.where(system: false).order(created_at: :desc).first %>
                  <% if last_message %>
                    <p class="text-xs text-gray-400 mt-1 truncate">
                      <%= truncate(last_message.body, length: 60) %>
                    </p>
                  <% end %>
                </div>
                <span class="badge badge-xs <%= request.status == "pending" ? 'bg-gray-100 text-gray-500 border-gray-200' : request_status_badge_class(request.status) %> ml-2 flex-shrink-0">
                  <%= format_request_status(request.status) %>
                </span>
              </div>
              <p class="text-xs text-gray-500">
                Pour <%= request.student&.first_name || "l'élève" %> • <%= format_subject_tag(request.subject) %> • <%= format_request_level(request.level) %>
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card bg-white shadow-md flex-shrink-0">
        <div class="card-body text-center py-12">
          <p class="text-gray-600 text-lg">Vous n'avez pas encore reçu de demandes.</p>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Colonne droite (2/3) - Chat -->
  <div class="flex-1 min-w-0 flex flex-col">
    <% if @active_request %>
      <%= render "conversation", request: @active_request %>
    <% else %>
      <div class="card bg-white shadow-lg h-full flex items-center justify-center">
        <div class="text-center">
          <p class="text-gray-600 text-lg mb-2">Sélectionnez une demande</p>
          <p class="text-gray-500 text-sm">Choisissez une conversation dans la liste pour commencer</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
