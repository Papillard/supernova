<div class="flex-none gap-6 items-center">
  <% if current_user.parent? %>
    <%= link_to "Mes demandes", requests_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 px-4" %>
  <% elsif current_user.teacher? %>
    <%= link_to "Mes demandes", teacher_requests_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 px-4" %>
  <% end %>
  <%= link_to "Annuaire des professeurs", teachers_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 px-4" %>
  <div class="dropdown dropdown-end">
    <label tabindex="0" class="btn btn-ghost btn-circle cursor-pointer">
      <div class="rounded-full overflow-hidden flex-shrink-0" style="width: 40px; height: 40px; background-color: #e5e7eb;">
        <% if current_user.first_name.present? || current_user.last_name.present? %>
          <div class="flex items-center justify-center text-gray-600 font-semibold text-sm" style="width: 40px; height: 40px; background-color: #e5e7eb;">
            <%= "#{current_user.first_name&.first || ''}#{current_user.last_name&.first || ''}".upcase %>
          </div>
        <% else %>
          <div class="flex items-center justify-center text-gray-600 font-semibold text-sm" style="width: 40px; height: 40px; background-color: #e5e7eb;">
            <%= current_user.email[0].upcase %>
          </div>
        <% end %>
      </div>
    </label>
    <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[100] p-2 shadow-lg bg-white rounded-lg w-48 border border-gray-200">
      <% if current_user.teacher? %>
        <li>
          <%= link_to "See profile", teacher_profile_path, class: "text-gray-700 px-2 py-2" %>
        </li>
      <% end %>
      <li>
        <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "text-red-600 px-2 py-2 text-left" %>
      </li>
    </ul>
  </div>
</div>
