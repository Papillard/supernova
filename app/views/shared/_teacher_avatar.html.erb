<%
  # Paramètres par défaut
  size = local_assigns.fetch(:size, :small)
  for_parent = local_assigns.fetch(:for_parent, false)
  shape = local_assigns.fetch(:shape, :round) # :round ou :square

  # Déterminer si on doit afficher la photo
  show_photo = false
  if teacher.profile_image_attached && teacher.profile_image_url.present?
    # Côté prof : toujours afficher la photo si elle existe
    # Côté parent : afficher si le profil est validé (approved) et visible dans l'annuaire (public_visible)
    show_photo = !for_parent || teacher.public_visible?
  end

  # Tailles
  size_classes = case size
  when :small
    { container: "w-10 h-10", text: "text-xs" }
  when :medium
    { container: "w-16 h-16", text: "text-lg" }
  when :large
    { container: "w-24 h-24", text: "text-2xl" }
  else
    { container: "w-10 h-10", text: "text-xs" }
  end

  # Forme : rond ou carré avec radius léger
  shape_class = shape == :square ? "rounded-lg" : "rounded-full"
%>

<div class="<%= shape_class %> overflow-hidden flex-shrink-0 bg-gray-300 flex items-center justify-center <%= size_classes[:container] %>">
  <% if show_photo %>
    <%= image_tag teacher.profile_image_url,
        alt: teacher_short_name(teacher),
        class: "object-cover #{size_classes[:container]}",
        onerror: "this.style.display='none'; this.nextElementSibling.style.display='flex';" %>
    <div class="hidden flex items-center justify-center text-gray-600 font-semibold <%= size_classes[:text] %> <%= size_classes[:container] %>">
      <%= teacher_initials(teacher) %>
    </div>
  <% else %>
    <div class="flex items-center justify-center text-gray-600 font-semibold <%= size_classes[:text] %> <%= size_classes[:container] %>">
      <%= teacher_initials(teacher) %>
    </div>
  <% end %>
</div>
