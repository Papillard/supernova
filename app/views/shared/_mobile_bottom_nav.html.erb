<% is_home_page_not_logged = !user_signed_in? && controller_name == 'pages' && action_name == 'home' %>
<!-- Mobile Bottom Navigation (visible only on mobile) -->
<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-stone-200 safe-area-bottom <%= 'home-bottom-nav-hidden' if is_home_page_not_logged %>">
  <% if user_signed_in? %>
    <%# Détection d'état actif par section %>
    <% is_annuaire_active = request.path.start_with?('/teachers') && !request.path.include?('/teacher/') %>
    <% is_requests_active = request.path.start_with?('/requests') || request.path.start_with?('/teacher/requests') %>
    <% is_profile_active = request.path == '/teacher/profile' || request.path == '/parent/profile' %>

    <!-- Version loggé : 3 liens -->
    <div class="flex items-center py-2">
      <%= link_to teachers_path, class: "flex-1 flex flex-col items-center gap-1 py-2 #{is_annuaire_active ? 'text-[#fe6618]' : 'text-gray-600 hover:text-[#fe6618]'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span class="text-xs font-medium">Annuaire</span>
      <% end %>

      <% requests_path_for_user = current_user.teacher? ? teacher_requests_path : requests_path %>
      <%= link_to requests_path_for_user, class: "flex-1 flex flex-col items-center gap-1 py-2 #{is_requests_active ? 'text-[#fe6618]' : 'text-gray-600 hover:text-[#fe6618]'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span class="text-xs font-medium">Demandes</span>
      <% end %>

      <% profile_path_for_user = current_user.teacher? ? teacher_profile_path : parent_profile_path %>
      <%= link_to profile_path_for_user, class: "flex-1 flex flex-col items-center gap-1 py-2 #{is_profile_active ? 'text-[#fe6618]' : 'text-gray-600 hover:text-[#fe6618]'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="text-xs font-medium">Profil</span>
      <% end %>
    </div>
  <% else %>
    <!-- Version non loggé : 2 boutons signup -->
    <div class="flex gap-3 p-3">
      <%= link_to new_parent_registration_path, class: "flex-1 btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white rounded-lg" do %>
        Je suis parent
      <% end %>
      <%= link_to new_teacher_registration_path, class: "flex-1 btn bg-white border border-stone-300 text-gray-900 hover:bg-stone-50 rounded-lg" do %>
        Je suis prof
      <% end %>
    </div>
  <% end %>
</nav>

<% if is_home_page_not_logged %>
<script>
  (function() {
    function initHomeBottomNav() {
      const heroSection = document.getElementById('hero-section');
      const bottomNav = document.querySelector('nav.home-bottom-nav-hidden');

      if (!heroSection || !bottomNav) return;

      function checkScroll() {
        const heroBottom = heroSection.getBoundingClientRect().bottom;
        const windowHeight = window.innerHeight;

        // Afficher la bottom nav si on a scrollé après la hero section
        if (heroBottom < windowHeight) {
          bottomNav.classList.remove('home-bottom-nav-hidden');
        } else {
          bottomNav.classList.add('home-bottom-nav-hidden');
        }
      }

      // Vérifier au chargement
      checkScroll();

      // Vérifier au scroll
      window.addEventListener('scroll', checkScroll, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomeBottomNav);
    } else {
      initHomeBottomNav();
    }

    document.addEventListener('turbo:load', initHomeBottomNav);
  })();
</script>
<% end %>
