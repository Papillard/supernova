<% if @is_avatar_upload %>
  <%= turbo_stream.replace "parent-avatar-container" do %>
    <div class="flex-shrink-0" id="parent-avatar-container">
      <%= render "shared/parent_avatar", parent_profile: @parent_profile, size: :large %>
      <div id="avatar-upload-loading" class="hidden mt-2 text-sm text-gray-500 text-center" data-avatar-upload-target="loadingIndicator">
        Upload en cours...
      </div>
    </div>
  <% end %>
<% end %>

<% if flash[:notice].present? || flash[:alert].present? %>
  <%= turbo_stream.replace "parent-profile-flash-messages" do %>
    <div id="parent-profile-flash-messages" class="text-sm">
      <% if flash[:notice].present? %>
        <div id="flash-notice" class="flex items-center gap-2 text-green-600 mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div id="flash-alert" class="flex items-center gap-2 text-red-600 mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>
    </div>
    <script>
      setTimeout(function() {
        var flashContainer = document.getElementById('parent-profile-flash-messages');
        if (flashContainer) {
          flashContainer.style.transition = 'opacity 0.3s ease-out';
          flashContainer.style.opacity = '0';
          setTimeout(function() {
            flashContainer.innerHTML = '';
            flashContainer.style.opacity = '1';
          }, 300);
        }
      }, 3000);
    </script>
  <% end %>
<% else %>
  <%= turbo_stream.replace "parent-profile-flash-messages" do %>
    <div id="parent-profile-flash-messages" class="text-sm"></div>
  <% end %>
<% end %>

<% if @parent_profile.profile_completed? %>
  <%= turbo_stream.replace "navbar-profile-completion-banner" do %>
    <div id="navbar-profile-completion-banner"></div>
  <% end %>
<% end %>
