<% if @is_avatar_upload %>
  <%= turbo_stream.replace "parent-avatar-container" do %>
    <div class="flex-shrink-0" id="parent-avatar-container">
      <%= render "shared/parent_avatar", parent_profile: @parent_profile, size: :large %>
      <div id="avatar-upload-loading" class="hidden mt-2 text-sm text-gray-500 text-center" data-avatar-upload-target="loadingIndicator">
        Upload en cours...
      </div>
    </div>
  <% end %>
<% end %>

<%= turbo_stream.replace "flash-messages" do %>
  <div id="flash-messages">
    <div class="alert alert-success" data-controller="flash" data-flash-auto-hide-value="true" data-flash-delay-value="3000">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= @is_avatar_upload ? "Photo de profil mise à jour avec succès." : "Infos enregistrées" %></span>
    </div>
  </div>
<% end %>

<% if @parent_profile.profile_completed? %>
  <%= turbo_stream.replace "navbar-profile-completion-banner" do %>
    <div id="navbar-profile-completion-banner"></div>
  <% end %>
<% end %>
