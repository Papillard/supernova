<% content_for :main_background, "background-color: oklch(0.985 0.002 247.839);" %>

<div class="container mx-auto max-w-2xl px-4 py-12">
  <div class="card bg-white shadow-lg">
    <div class="card-body">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Bienvenue !</h1>
      <p class="text-gray-600 mb-6">
        Pour créer des demandes de cours, nous avons besoin de quelques informations sur vous et vos enfants.
      </p>

      <div class="space-y-4 mb-8">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#fe6618]/10 flex items-center justify-center">
            <span class="text-[#fe6618] font-semibold">1</span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Vos informations personnelles</h3>
            <p class="text-sm text-gray-600">Prénom, nom et adresse</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#fe6618]/10 flex items-center justify-center">
            <span class="text-[#fe6618] font-semibold">2</span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Ajouter vos enfants</h3>
            <p class="text-sm text-gray-600">Au moins un enfant est requis pour créer des demandes</p>
          </div>
        </div>
      </div>

      <div class="flex gap-4">
        <%= link_to parent_profile_path, class: "btn btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white flex-1" do %>
          <span class="md:hidden">Compléter</span>
          <span class="hidden md:inline">Compléter mon profil</span>
        <% end %>
        <%= link_to "Passer pour l'instant", teachers_path, class: "btn btn-ghost flex-1" %>
      </div>
    </div>
  </div>
</div>
