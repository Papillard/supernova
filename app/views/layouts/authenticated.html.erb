<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "ProfConnect" %></title>
    <meta name="description" content="<%= content_for(:description) || "ProfConnect met en relation parents et professeurs de l'Éducation Nationale pour des cours particuliers en maths, français, anglais et sciences." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Google Fonts: Nunito Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,900;1,6..12,900&display=swap" rel="stylesheet">

    <% if ENV["GOOGLE_MAPS_API_KEY"].present? %>
      <meta name="google-places-api-key" content="<%= ENV["GOOGLE_MAPS_API_KEY"] %>">
    <% end %>

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-100 text-base-content">
    <!-- Flash Messages -->
    <div id="flash-messages" class="fixed top-20 md:top-24 right-4 z-[70] space-y-2 max-w-md">
      <%= render "shared/flash" %>
    </div>

    <div class="min-h-screen flex flex-col">
      <!-- Bandeau promotionnel -->
      <div class="sticky top-0 z-[60] w-full bg-[#FAEBE5] border-b border-[#fe6618]/20">
        <div class="max-w-full mx-auto px-4 py-2">
          <p class="text-sm text-center text-[#fe6618] font-medium whitespace-nowrap overflow-hidden text-ellipsis">
            ⚡ Offre de lancement: accès gratuit pendant 1 an pour les 200 premiers professeurs.
          </p>
        </div>
      </div>

      <!-- Mobile Header (visible only on mobile) -->
      <header class="md:hidden sticky top-[36px] z-50 bg-white border-b border-stone-200">
        <div class="px-4 py-3 flex items-center justify-between">
          <%= link_to root_path do %>
            <%= image_tag "logo.png", alt: "ProfConnect", style: "height: 40px; width: auto;" %>
          <% end %>
          <% if user_signed_in? %>
            <div class="dropdown dropdown-end">
              <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                <div class="w-9 rounded-full bg-gray-200 flex items-center justify-center overflow-hidden">
                  <% if current_user.teacher? && current_user.teacher&.profile_image_url.present? %>
                    <%= image_tag current_user.teacher.profile_image_url, alt: "Avatar", class: "w-full h-full object-cover" %>
                  <% else %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                  <% end %>
                </div>
              </label>
              <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[100] p-2 shadow bg-white rounded-box w-40">
                <li>
                  <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "text-left w-full" %>
                </li>
              </ul>
            </div>
          <% end %>
        </div>
      </header>

      <!-- Desktop Navbar (hidden on mobile) -->
      <header class="hidden md:block sticky top-[36px] z-50 bg-white border-b border-stone-200">
        <div class="navbar max-w-7xl mx-auto px-4 md:px-6">
          <div class="flex-1">
            <%= link_to root_path, class: "flex items-center space-x-2" do %>
              <%= image_tag "logo.png", alt: "ProfConnect", style: "height: 50px; width: auto;" %>
            <% end %>
          </div>
          <div class="flex-none gap-6 items-center">
            <% if user_signed_in? %>
              <%= render "shared/navbar_logged_in" %>
            <% else %>
              <%= link_to "Se connecter", new_user_session_path, class: "btn btn-ghost" %>
            <% end %>
          </div>
        </div>
      </header>

      <!-- Profile completion banner for parents -->
      <% if user_signed_in? && current_user.parent? %>
        <% parent_profile = current_user.parent_profile %>
        <div id="navbar-profile-completion-banner">
          <% unless parent_profile&.profile_completed? %>
            <% has_personal_info = parent_profile&.first_name.present? && parent_profile&.last_name.present? %>
            <% has_no_students = parent_profile&.students&.empty? %>
            <% if has_personal_info && has_no_students %>
              <div class="bg-yellow-50 border-b border-yellow-200">
                <div class="max-w-7xl mx-auto px-4 md:px-6 py-3">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="hidden md:block h-5 w-5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                      </svg>
                      <p class="text-sm text-yellow-800">
                        <span class="font-semibold">Profil incomplet :</span> Ajoutez des informations sur vos enfants.
                      </p>
                    </div>
                    <%= link_to "Compléter mon profil", parent_profile_path, class: "btn btn-sm btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white" %>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="bg-yellow-50 border-b border-yellow-200">
                <div class="max-w-7xl mx-auto px-4 md:px-6 py-3">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <svg xmlns="http://www.w3.org/2000/svg" class="hidden md:block h-5 w-5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                      </svg>
                      <p class="text-sm text-yellow-800">
                        <span class="font-semibold">Profil incomplet :</span> Complétez votre profil pour créer des demandes de cours.
                      </p>
                    </div>
                    <%= link_to "Compléter mon profil", parent_profile_path, class: "btn btn-sm btn-primary bg-[#fe6618] hover:bg-[#d85514] border-[#fe6618] text-white" %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <!-- Main content -->
      <main class="flex-1 <%= content_for?(:hide_mobile_nav) ? '' : 'pb-20' %> md:pb-0" style="<%= content_for(:main_background).presence || 'background-color: oklch(0.985 0.002 247.839);' %>">
        <%= yield %>
      </main>

      <% unless content_for?(:hide_mobile_nav) %>
        <%= render "shared/mobile_bottom_nav" %>
      <% end %>
    </div>
  </body>
</html>
