<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-gray-900">ProfConnect</h1>
      <h2 class="mt-2 text-xl text-gray-600">Changer votre mot de passe</h2>
    </div>

    <div class="card bg-white shadow-lg">
      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

          <div class="form-control">
            <%= f.label :password, "Nouveau mot de passe", class: "label" do %>
              <span class="label-text">Nouveau mot de passe</span>
              <% if @minimum_password_length %>
                <span class="label-text-alt">(<%= @minimum_password_length %> caractères minimum)</span>
              <% end %>
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input input-bordered w-full", placeholder: "••••••••" %>
          </div>

          <div class="form-control">
            <%= f.label :password_confirmation, "Confirmer le nouveau mot de passe", class: "label" do %>
              <span class="label-text">Confirmer le nouveau mot de passe</span>
            <% end %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full", placeholder: "••••••••" %>
          </div>

          <div class="form-control mt-6">
            <%= f.submit "Changer mon mot de passe", class: "btn btn-primary bg-blue-600 hover:bg-blue-700 border-blue-600 text-white rounded-lg w-full" %>
          </div>
        <% end %>

        <div class="divider">OU</div>

        <div class="text-center">
          <p class="text-sm text-gray-600">
            <%= link_to "Retour à la connexion", new_session_path(resource_name), class: "link link-primary" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
